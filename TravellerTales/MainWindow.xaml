<Window x:Class="TravellerTales.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Traveller Tales"
        MinHeight="720"
        MinWidth="1280"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Icon="pack://application:,,,/Assets/icon.ico"
        Background="Black"
        Foreground="{StaticResource AppForegroundBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="LandingOverlayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonFrame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#00FFFFFF"
                                BorderThickness="2"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonFrame" Property="Background" Value="#224AA3FF" />
                                <Setter TargetName="ButtonFrame" Property="BorderBrush" Value="#AA7EC7FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonFrame" Property="Background" Value="#334AA3FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="ButtonFrame" Property="Background" Value="Transparent" />
                                <Setter TargetName="ButtonFrame" Property="BorderBrush" Value="#00FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlaceholderButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Padding" Value="22,8" />
            <Setter Property="Background" Value="#151D2A" />
            <Setter Property="BorderBrush" Value="#4FA7FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#EAF6FF" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Background="Black">
        <Grid x:Name="LandingView" Visibility="Visible">
            <Viewbox Stretch="UniformToFill"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch">
                <Grid Width="1672"
                      Height="941"
                      IsHitTestVisible="True">
                    <Image Source="pack://application:,,,/Assets/landing.png"
                           Stretch="Fill" />

                <Button x:Name="ContinueButton"
                        Width="395"
                        Height="72"
                        Margin="1217,143,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        IsEnabled="False"
                        AutomationProperties.Name="Continue"
                        ToolTip="Continue will be available when an in-progress character exists."
                        Style="{StaticResource LandingOverlayButtonStyle}" />
                <Button Width="395"
                        Height="72"
                        Margin="1217,231,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Click="OnNewCharacter"
                        AutomationProperties.Name="New Character"
                        ToolTip="New Character"
                        Style="{StaticResource LandingOverlayButtonStyle}" />
                <Button Width="395"
                        Height="72"
                        Margin="1217,320,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Click="OnEditNarratives"
                        AutomationProperties.Name="Edit Narratives"
                        ToolTip="Edit Narratives"
                        Style="{StaticResource LandingOverlayButtonStyle}" />
                <Button Width="395"
                        Height="72"
                        Margin="1217,410,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Click="OnSettings"
                        AutomationProperties.Name="Settings"
                        ToolTip="Settings"
                        Style="{StaticResource LandingOverlayButtonStyle}" />
                <Button Width="395"
                        Height="72"
                        Margin="1217,498,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Click="OnCredits"
                        AutomationProperties.Name="Credits"
                        ToolTip="Credits"
                        Style="{StaticResource LandingOverlayButtonStyle}" />
                <Button Width="395"
                        Height="72"
                        Margin="1217,586,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Click="OnExit"
                        AutomationProperties.Name="Exit"
                        ToolTip="Exit"
                        Style="{StaticResource LandingOverlayButtonStyle}" />
                </Grid>
            </Viewbox>
        </Grid>

        <Grid x:Name="PlaceholderView"
              Visibility="Collapsed"
              Background="#EE05080F">
            <Grid MaxWidth="1180"
                  Margin="72"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="PlaceholderTitle"
                           Text="Placeholder"
                           FontSize="54"
                           FontWeight="SemiBold"
                           Foreground="#EAF6FF" />
                <TextBlock x:Name="PlaceholderBody"
                           Grid.Row="1"
                           Margin="0,22,0,34"
                           TextWrapping="Wrap"
                           FontSize="24"
                           LineHeight="34"
                           Foreground="#BEDFFF" />
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal">
                    <Button Content="Back"
                            Click="OnBackToLanding"
                            AutomationProperties.Name="Back"
                            Style="{StaticResource PlaceholderButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
