<Window x:Class="TravellerTales.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TravellerTales.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Traveller Tales"
        MinHeight="720"
        MinWidth="1280"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Icon="pack://application:,,,/Assets/icon.ico"
        Background="Black"
        Foreground="{StaticResource AppForegroundBrush}"
        FontFamily="{StaticResource BodyTextFontFamily}">
    <Window.Resources>
        <Style x:Key="LandingPolygonButtonStyle" TargetType="{x:Type controls:PolygonButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="Transparent" />
            <Setter Property="FontFamily" Value="{StaticResource LabelButtonFontFamily}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HoverFill" Value="#2237AFFF" />
            <Setter Property="HoverStroke" Value="#887EDBFF" />
            <Setter Property="PressedFill" Value="#334AA3FF" />
            <Setter Property="ShapeFill" Value="Transparent" />
            <Setter Property="ShapeStroke" Value="Transparent" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:PolygonButton}">
                        <ContentPresenter HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlaceholderButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Padding" Value="22,8" />
            <Setter Property="Background" Value="#151D2A" />
            <Setter Property="BorderBrush" Value="#4FA7FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#EAF6FF" />
            <Setter Property="FontFamily" Value="{StaticResource LabelButtonFontFamily}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SettingsButtonStyle" TargetType="Button" BasedOn="{StaticResource PlaceholderButtonStyle}">
            <Setter Property="MinWidth" Value="142" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="Background" Value="#AA061521" />
            <Setter Property="BorderBrush" Value="#8CE8FF" />
            <Setter Property="Foreground" Value="#EAFBFF" />
        </Style>

        <Style x:Key="SettingsInputStyle" TargetType="TextBox">
            <Setter Property="Width" Value="250" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#BF071523" />
            <Setter Property="BorderBrush" Value="#5FD9FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#DFFBFF" />
            <Setter Property="CaretBrush" Value="#DFFBFF" />
            <Setter Property="FontFamily" Value="{StaticResource DataFieldFontFamily}" />
            <Setter Property="FontSize" Value="22" />
        </Style>
    </Window.Resources>

    <Grid Background="Black">
        <Grid x:Name="LandingView" Visibility="Visible">
            <Viewbox Stretch="UniformToFill"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch">
                <Grid Width="1672"
                      Height="941"
                      IsHitTestVisible="True">
                    <Image Source="pack://application:,,,/Assets/landing.png"
                           Stretch="Fill" />

                    <StackPanel Margin="44,36,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False"
                                Opacity="0.82">
                        <TextBlock Text="Traveller Tales"
                                   Style="{StaticResource AppTitleTextStyle}"
                                   FontSize="46"
                                   Foreground="#D8F1FF" />
                        <TextBlock Text="{Binding VersionText}"
                                   Style="{StaticResource DataFieldTextStyle}"
                                   FontSize="17"
                                   Foreground="#9FCFFF"
                                   Margin="4,2,0,0" />
                    </StackPanel>

                    <controls:PolygonButton x:Name="ContinueButton"
                                            Width="1672"
                                            Height="941"
                                            IsEnabled="False"
                                            AutomationProperties.Name="Continue"
                                            ToolTip="Continue will be available when an in-progress character exists."
                                            ToolTipService.ShowOnDisabled="True"
                                            ShapeFill="Transparent"
                                            ShapeStroke="Transparent"
                                            ShapeData="M 696,379 L 970,379 L 970,419 L 696,419 Z"
                                            Style="{StaticResource LandingPolygonButtonStyle}" />
                    <controls:PolygonButton Width="1672"
                                            Height="941"
                                            Click="OnNewCharacter"
                                            AutomationProperties.Name="New Character"
                                            ToolTip="New Character"
                                            ShapeFill="Transparent"
                                            ShapeStroke="Transparent"
                                            ShapeData="M 696,425 L 970,425 L 970,463 L 696,463 Z"
                                            Style="{StaticResource LandingPolygonButtonStyle}" />
                    <controls:PolygonButton Width="1672"
                                            Height="941"
                                            Click="OnEditNarratives"
                                            AutomationProperties.Name="Edit Narratives"
                                            ToolTip="Edit Narratives"
                                            ShapeFill="Transparent"
                                            ShapeStroke="Transparent"
                                            ShapeData="M 696,470 L 970,470 L 970,509 L 696,509 Z"
                                            Style="{StaticResource LandingPolygonButtonStyle}" />
                    <controls:PolygonButton Width="1672"
                                            Height="941"
                                            Click="OnSettings"
                                            AutomationProperties.Name="Settings"
                                            ToolTip="Settings"
                                            ShapeFill="Transparent"
                                            ShapeStroke="Transparent"
                                            ShapeData="M 696,515 L 970,515 L 970,554 L 696,554 Z"
                                            Style="{StaticResource LandingPolygonButtonStyle}" />
                    <controls:PolygonButton Width="1672"
                                            Height="941"
                                            Click="OnCredits"
                                            AutomationProperties.Name="Credits"
                                            ToolTip="Credits"
                                            ShapeFill="Transparent"
                                            ShapeStroke="Transparent"
                                            ShapeData="M 696,560 L 970,560 L 970,599 L 696,599 Z"
                                            Style="{StaticResource LandingPolygonButtonStyle}" />
                    <controls:PolygonButton Width="1672"
                                            Height="941"
                                            Click="OnExit"
                                            AutomationProperties.Name="Exit"
                                            ToolTip="Exit"
                                            ShapeFill="Transparent"
                                            ShapeStroke="Transparent"
                                            ShapeData="M 696,605 L 970,605 L 970,644 L 696,644 Z"
                                            Style="{StaticResource LandingPolygonButtonStyle}" />
                </Grid>
            </Viewbox>
        </Grid>

        <Grid x:Name="PlaceholderView"
              Visibility="Collapsed"
              Background="#EE05080F">
            <Grid MaxWidth="1180"
                  Margin="72"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="PlaceholderTitle"
                           Text="Placeholder"
                           Style="{StaticResource SectionHeaderTextStyle}"
                           FontSize="54"
                           FontWeight="SemiBold"
                           Foreground="#EAF6FF" />
                <TextBlock x:Name="PlaceholderBody"
                           Grid.Row="1"
                           Style="{StaticResource BodyTextStyle}"
                           Margin="0,22,0,34"
                           TextWrapping="Wrap"
                           FontSize="24"
                           LineHeight="34"
                           Foreground="#BEDFFF" />
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal">
                    <Button Content="Back"
                            Click="OnBackToLanding"
                            AutomationProperties.Name="Back"
                            Style="{StaticResource PlaceholderButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="SettingsView" Visibility="Collapsed">
            <Viewbox Stretch="UniformToFill"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch">
                <Grid Width="1672"
                      Height="941">
                    <Image Source="pack://application:,,,/Assets/engine.png"
                           Stretch="Fill" />

                    <Grid Margin="270,205,570,240"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          IsHitTestVisible="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="ENGINE SETTINGS"
                                   Style="{StaticResource SectionHeaderTextStyle}"
                                   FontSize="34"
                                   Foreground="#D8F8FF"
                                   Opacity="0.92" />

                        <Grid Grid.Row="1"
                              Margin="0,42,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="SPLASH DURATION SECONDS"
                                       Style="{StaticResource SectionHeaderTextStyle}"
                                       FontSize="24"
                                       Foreground="#9FEFFF"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="SplashDurationTextBox"
                                     Grid.Column="1"
                                     Style="{StaticResource SettingsInputStyle}"
                                     TextChanged="OnSettingsValueChanged"
                                     AutomationProperties.Name="Splash Duration Seconds" />

                            <TextBlock Grid.Row="2"
                                       Text="APPLICATION VERSION"
                                       Style="{StaticResource SectionHeaderTextStyle}"
                                       FontSize="24"
                                       Foreground="#9FEFFF"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="ApplicationVersionTextBox"
                                     Grid.Row="2"
                                     Grid.Column="1"
                                     Style="{StaticResource SettingsInputStyle}"
                                     TextChanged="OnSettingsValueChanged"
                                     AutomationProperties.Name="Application Version" />
                        </Grid>

                        <TextBlock x:Name="SettingsValidationMessage"
                                   Grid.Row="2"
                                   Margin="0,30,0,0"
                                   Style="{StaticResource BodyTextStyle}"
                                   FontSize="20"
                                   Foreground="#FFB36A"
                                   TextWrapping="Wrap" />
                    </Grid>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,68">
                        <Button x:Name="SettingsSaveButton"
                                Content="Save"
                                Click="OnSaveSettings"
                                Visibility="Collapsed"
                                AutomationProperties.Name="Save"
                                Style="{StaticResource SettingsButtonStyle}" />
                        <Button x:Name="SettingsCancelButton"
                                Content="Cancel"
                                Click="OnCancelSettings"
                                Visibility="Collapsed"
                                AutomationProperties.Name="Cancel"
                                Style="{StaticResource SettingsButtonStyle}" />
                        <Button x:Name="SettingsCloseButton"
                                Content="Close"
                                Click="OnCloseSettings"
                                Visibility="Visible"
                                AutomationProperties.Name="Close"
                                Style="{StaticResource SettingsButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Viewbox>
        </Grid>
    </Grid>
</Window>
