<Window x:Class="TravellerTales.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TravellerTales.Controls"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:views="clr-namespace:TravellerTales.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Traveller Tales"
        MinHeight="720"
        MinWidth="1280"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Icon="pack://application:,,,/Assets/icon.ico"
        Background="Black"
        Foreground="{StaticResource AppForegroundBrush}"
        FontFamily="{StaticResource BodyTextFontFamily}">
    <Window.Resources>
        <Style x:Key="LandingPolygonButtonStyle" TargetType="{x:Type controls:PolygonButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="Transparent" />
            <Setter Property="FontFamily" Value="{StaticResource LabelButtonFontFamily}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HoverFill" Value="#2237AFFF" />
            <Setter Property="HoverStroke" Value="#887EDBFF" />
            <Setter Property="PressedFill" Value="#334AA3FF" />
            <Setter Property="ShapeFill" Value="Transparent" />
            <Setter Property="ShapeStroke" Value="Transparent" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:PolygonButton}">
                        <ContentPresenter HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlaceholderButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Padding" Value="22,8" />
            <Setter Property="Background" Value="#151D2A" />
            <Setter Property="BorderBrush" Value="#4FA7FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#EAF6FF" />
            <Setter Property="FontFamily" Value="{StaticResource LabelButtonFontFamily}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SettingsButtonStyle" TargetType="Button" BasedOn="{StaticResource PlaceholderButtonStyle}">
            <Setter Property="MinWidth" Value="142" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="Background" Value="#AA061521" />
            <Setter Property="BorderBrush" Value="#8CE8FF" />
            <Setter Property="Foreground" Value="#EAFBFF" />
        </Style>

        <Style x:Key="SettingsInputStyle" TargetType="TextBox">
            <Setter Property="Width" Value="250" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#BF071523" />
            <Setter Property="BorderBrush" Value="#5FD9FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#DFFBFF" />
            <Setter Property="CaretBrush" Value="#DFFBFF" />
            <Setter Property="FontFamily" Value="{StaticResource DataFieldFontFamily}" />
            <Setter Property="FontSize" Value="22" />
        </Style>

        <Style x:Key="SettingsDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Width" Value="250" />
            <Setter Property="Height" Value="44" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#BF071523" />
            <Setter Property="BorderBrush" Value="#5FD9FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#DFFBFF" />
            <Setter Property="FontFamily" Value="{StaticResource DataFieldFontFamily}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid x:Name="PART_Root"
                              Width="{TemplateBinding Width}"
                              Height="{TemplateBinding Height}">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="38" />
                                    </Grid.ColumnDefinitions>

                                    <primitives:DatePickerTextBox x:Name="PART_TextBox"
                                                                  Grid.Column="0"
                                                                  Visibility="Collapsed"
                                                                  Background="Transparent"
                                                                  BorderBrush="Transparent"
                                                                  BorderThickness="0"
                                                                  Foreground="{TemplateBinding Foreground}"
                                                                  FontFamily="{TemplateBinding FontFamily}"
                                                                  FontSize="{TemplateBinding FontSize}"
                                                                  Padding="12,0"
                                                                  HorizontalContentAlignment="Left"
                                                                  TextAlignment="Left"
                                                                  VerticalContentAlignment="Center" />

                                    <TextBlock x:Name="BuildDateDisplayText"
                                               Grid.Column="0"
                                               Margin="12,0,0,0"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontSize="{TemplateBinding FontSize}"
                                               Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />

                                    <Button x:Name="PART_Button"
                                            Grid.Column="1"
                                            Background="#00000000"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            Foreground="#DFFBFF"
                                            FontFamily="{StaticResource LabelButtonFontFamily}"
                                            FontSize="16"
                                            Content="▼"
                                            Cursor="Hand" />
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=PART_Root}"
                                   StaysOpen="False" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsDatePickerTextBoxStyle" TargetType="{x:Type primitives:DatePickerTextBox}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#DFFBFF" />
            <Setter Property="CaretBrush" Value="#DFFBFF" />
            <Setter Property="FontFamily" Value="{StaticResource DataFieldFontFamily}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:DatePickerTextBox}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Focusable="False" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LicenseLinkTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DFFBFF" />
            <Setter Property="FontFamily" Value="{StaticResource DataFieldFontFamily}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="TextDecorations" Value="Underline" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="Black">
        <Grid x:Name="LandingView" Visibility="Visible">
            <Viewbox Stretch="UniformToFill"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch">
                <Grid Width="1672"
                      Height="941"
                      IsHitTestVisible="True">
                    <Image Source="pack://application:,,,/Assets/landing.png"
                           Stretch="Fill" />

                    <StackPanel Margin="44,36,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False"
                                Opacity="0.82">
                        <TextBlock Text="Traveller Tales"
                                   Style="{StaticResource AppTitleTextStyle}"
                                   FontSize="46"
                                   Foreground="#D8F1FF" />
                        <TextBlock Text="{Binding VersionText}"
                                   Style="{StaticResource DataFieldTextStyle}"
                                   FontSize="17"
                                   Foreground="#9FCFFF"
                                   Margin="4,2,0,0" />
                    </StackPanel>

                    <controls:PolygonButton x:Name="ContinueButton"
                                            Width="1672"
                                            Height="941"
                                            IsEnabled="False"
                                            Click="OnContinueCharacter"
                                            AutomationProperties.Name="Continue"
                                            ToolTip="Continue will be available when an in-progress character exists."
                                            ToolTipService.ShowOnDisabled="True"
                                            ShapeFill="Transparent"
                                            ShapeStroke="Transparent"
                                            ShapeData="M 696,379 L 970,379 L 970,419 L 696,419 Z"
                                            Style="{StaticResource LandingPolygonButtonStyle}" />
                    <controls:PolygonButton Width="1672"
                                            Height="941"
                                            Click="OnNewCharacter"
                                            AutomationProperties.Name="New Character"
                                            ToolTip="New Character"
                                            ShapeFill="Transparent"
                                            ShapeStroke="Transparent"
                                            ShapeData="M 696,425 L 970,425 L 970,463 L 696,463 Z"
                                            Style="{StaticResource LandingPolygonButtonStyle}" />
                    <controls:PolygonButton Width="1672"
                                            Height="941"
                                            Click="OnEditNarratives"
                                            AutomationProperties.Name="Edit Narratives"
                                            ToolTip="Edit Narratives"
                                            ShapeFill="Transparent"
                                            ShapeStroke="Transparent"
                                            ShapeData="M 696,470 L 970,470 L 970,509 L 696,509 Z"
                                            Style="{StaticResource LandingPolygonButtonStyle}" />
                    <controls:PolygonButton Width="1672"
                                            Height="941"
                                            Click="OnSettings"
                                            AutomationProperties.Name="Settings"
                                            ToolTip="Settings"
                                            ShapeFill="Transparent"
                                            ShapeStroke="Transparent"
                                            ShapeData="M 696,515 L 970,515 L 970,554 L 696,554 Z"
                                            Style="{StaticResource LandingPolygonButtonStyle}" />
                    <controls:PolygonButton Width="1672"
                                            Height="941"
                                            Click="OnCredits"
                                            AutomationProperties.Name="Credits"
                                            ToolTip="Credits"
                                            ShapeFill="Transparent"
                                            ShapeStroke="Transparent"
                                            ShapeData="M 696,560 L 970,560 L 970,599 L 696,599 Z"
                                            Style="{StaticResource LandingPolygonButtonStyle}" />
                    <controls:PolygonButton Width="1672"
                                            Height="941"
                                            Click="OnExit"
                                            AutomationProperties.Name="Exit"
                                            ToolTip="Exit"
                                            ShapeFill="Transparent"
                                            ShapeStroke="Transparent"
                                            ShapeData="M 696,605 L 970,605 L 970,644 L 696,644 Z"
                                            Style="{StaticResource LandingPolygonButtonStyle}" />
                </Grid>
            </Viewbox>
        </Grid>

        <Grid x:Name="PlaceholderView"
              Visibility="Collapsed"
              Background="#EE05080F">
            <Grid MaxWidth="1180"
                  Margin="72"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="PlaceholderTitle"
                           Text="Placeholder"
                           Style="{StaticResource SectionHeaderTextStyle}"
                           FontSize="54"
                           FontWeight="SemiBold"
                           Foreground="#EAF6FF" />
                <TextBlock x:Name="PlaceholderBody"
                           Grid.Row="1"
                           Style="{StaticResource BodyTextStyle}"
                           Margin="0,22,0,34"
                           TextWrapping="Wrap"
                           FontSize="24"
                           LineHeight="34"
                           Foreground="#BEDFFF" />
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal">
                    <Button Content="Back"
                            Click="OnBackToLanding"
                            AutomationProperties.Name="Back"
                            Style="{StaticResource PlaceholderButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="NewCharacterWizardView"
              Visibility="Collapsed">
            <views:NewCharacterWizardControl x:Name="NewCharacterWizard"
                                             SaveRequested="OnSaveCharacterCreation"
                                             CheckpointSaveRequested="OnCheckpointSaveCharacterCreation"
                                             CancelRequested="OnCancelCharacterCreation" />
        </Grid>

        <Grid x:Name="SettingsView" Visibility="Collapsed">
            <Viewbox Stretch="UniformToFill"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch">
                <Grid Width="1672"
                      Height="941">
                    <Image Source="pack://application:,,,/Assets/engine.png"
                           Stretch="Fill" />

                    <Grid Margin="270,205,570,240"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          IsHitTestVisible="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="ENGINE SETTINGS"
                                   Style="{StaticResource SectionHeaderTextStyle}"
                                   FontSize="34"
                                   Foreground="#D8F8FF"
                                   Opacity="0.92" />

                        <Grid Grid.Row="1"
                              Margin="0,42,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="SPLASH DURATION SECONDS"
                                       Style="{StaticResource SectionHeaderTextStyle}"
                                       FontSize="24"
                                       Foreground="#9FEFFF"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="SplashDurationTextBox"
                                     Grid.Column="1"
                                     Style="{StaticResource SettingsInputStyle}"
                                     TextChanged="OnSettingsValueChanged"
                                     AutomationProperties.Name="Splash Duration Seconds" />

                            <TextBlock Grid.Row="2"
                                       Text="APPLICATION VERSION"
                                       Style="{StaticResource SectionHeaderTextStyle}"
                                       FontSize="24"
                                       Foreground="#9FEFFF"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="ApplicationVersionTextBox"
                                     Grid.Row="2"
                                     Grid.Column="1"
                                     Style="{StaticResource SettingsInputStyle}"
                                     TextChanged="OnSettingsValueChanged"
                                     AutomationProperties.Name="Application Version" />

                            <TextBlock Grid.Row="4"
                                       Text="BUILD DATE"
                                       Style="{StaticResource SectionHeaderTextStyle}"
                                       FontSize="24"
                                       Foreground="#9FEFFF"
                                       VerticalAlignment="Center" />
                            <DatePicker x:Name="BuildDatePicker"
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Style="{StaticResource SettingsDatePickerStyle}"
                                        SelectedDateChanged="OnSettingsDateChanged"
                                        AutomationProperties.Name="Build Date">
                                <DatePicker.Resources>
                                    <Style TargetType="{x:Type primitives:DatePickerTextBox}"
                                           BasedOn="{StaticResource SettingsDatePickerTextBoxStyle}" />
                                </DatePicker.Resources>
                            </DatePicker>
                        </Grid>

                        <TextBlock x:Name="SettingsValidationMessage"
                                   Grid.Row="2"
                                   Margin="0,30,0,0"
                                   Style="{StaticResource BodyTextStyle}"
                                   FontSize="20"
                                   Foreground="#FFB36A"
                                   TextWrapping="Wrap" />
                    </Grid>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,110">
                        <Button x:Name="SettingsSaveButton"
                                Content="Save"
                                Click="OnSaveSettings"
                                Visibility="Collapsed"
                                AutomationProperties.Name="Save"
                                Style="{StaticResource SettingsButtonStyle}" />
                        <Button x:Name="SettingsCancelButton"
                                Content="Cancel"
                                Click="OnCancelSettings"
                                Visibility="Collapsed"
                                AutomationProperties.Name="Cancel"
                                Style="{StaticResource SettingsButtonStyle}" />
                        <Button x:Name="SettingsCloseButton"
                                Content="Close"
                                Click="OnCloseSettings"
                                Visibility="Visible"
                                AutomationProperties.Name="Close"
                                Style="{StaticResource SettingsButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Viewbox>
        </Grid>

        <Grid x:Name="CreditsView" Visibility="Collapsed">
            <Viewbox Stretch="UniformToFill"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch">
                <Grid Width="1672"
                      Height="941">
                    <Image Source="pack://application:,,,/Assets/credits.png"
                           Stretch="Fill" />

                    <Grid Margin="210,150,210,145"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          IsHitTestVisible="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="CREDITS"
                                   Style="{StaticResource AppTitleTextStyle}"
                                   FontSize="54"
                                   Foreground="#D8F8FF"
                                   HorizontalAlignment="Center"
                                   Opacity="0.94" />

                        <Grid Grid.Row="1"
                              Margin="0,54,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="0.9*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,20,0">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="300" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="APPLICATION NAME:"
                                               Style="{StaticResource SectionHeaderTextStyle}"
                                               FontSize="23"
                                               Foreground="#9FEFFF" />
                                    <TextBlock Grid.Column="1"
                                               Text="Traveller Tales"
                                               Style="{StaticResource DataFieldTextStyle}"
                                               FontSize="25"
                                               Foreground="#EAFBFF" />

                                    <TextBlock Grid.Row="2"
                                               Text="VERSION:"
                                               Style="{StaticResource SectionHeaderTextStyle}"
                                               FontSize="23"
                                               Foreground="#9FEFFF" />
                                    <TextBlock x:Name="CreditsVersionValue"
                                               Grid.Row="2"
                                               Grid.Column="1"
                                               Style="{StaticResource DataFieldTextStyle}"
                                               FontSize="25"
                                               Foreground="#EAFBFF" />

                                    <TextBlock Grid.Row="4"
                                               Text="BUILD DATE:"
                                               Style="{StaticResource SectionHeaderTextStyle}"
                                               FontSize="23"
                                               Foreground="#9FEFFF" />
                                    <TextBlock x:Name="CreditsBuildDateValue"
                                               Grid.Row="4"
                                               Grid.Column="1"
                                               Style="{StaticResource DataFieldTextStyle}"
                                               FontSize="25"
                                               Foreground="#EAFBFF" />
                                </Grid>

                                <StackPanel Margin="0,72,0,0"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="©2026 Jarrow Enclave. All Rights Reserved"
                                               Style="{StaticResource BodyTextStyle}"
                                               FontSize="24"
                                               Foreground="#D8F8FF"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Created by Robert &quot;Wizard&quot; Johnson"
                                               Style="{StaticResource BodyTextStyle}"
                                               FontSize="24"
                                               Foreground="#D8F8FF"
                                               HorizontalAlignment="Center"
                                               Margin="0,22,0,0" />
                                    <TextBlock Text="Support: sgt.jarrow@gmail.com"
                                               Style="{StaticResource DataFieldTextStyle}"
                                               FontSize="23"
                                               Foreground="#BFEFFF"
                                               HorizontalAlignment="Center"
                                               Margin="0,44,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Margin="20,0,0,0"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="THIRD-PARTY LICENSES"
                                           Style="{StaticResource SectionHeaderTextStyle}"
                                           FontSize="27"
                                           Foreground="#9FEFFF"
                                           TextDecorations="Underline"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,28" />
                                <TextBlock Text="FONTS"
                                           Style="{StaticResource SectionHeaderTextStyle}"
                                           FontSize="22"
                                           Foreground="#9FEFFF"
                                           HorizontalAlignment="Left"
                                           Margin="0,0,0,20" />

                                <Grid Width="480"
                                      HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="310" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Orbitron"
                                               Style="{StaticResource BodyTextStyle}"
                                               FontSize="19"
                                               Foreground="#D8F8FF" />
                                    <TextBlock Grid.Column="1"
                                               Text="SIL Open Font License 1.1"
                                               Tag="OFL-Orbitron.txt"
                                               MouseLeftButtonUp="OnShowLicense"
                                               AutomationProperties.Name="Orbitron License"
                                               Style="{StaticResource LicenseLinkTextStyle}" />

                                    <TextBlock Grid.Row="2"
                                               Text="Rajdhani"
                                               Style="{StaticResource BodyTextStyle}"
                                               FontSize="19"
                                               Foreground="#D8F8FF" />
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="1"
                                               Text="SIL Open Font License 1.1"
                                               Tag="OFL-Rajdhani.txt"
                                               MouseLeftButtonUp="OnShowLicense"
                                               AutomationProperties.Name="Rajdhani License"
                                               Style="{StaticResource LicenseLinkTextStyle}" />

                                    <TextBlock Grid.Row="4"
                                               Text="Exo 2"
                                               Style="{StaticResource BodyTextStyle}"
                                               FontSize="19"
                                               Foreground="#D8F8FF" />
                                    <TextBlock Grid.Row="4"
                                               Grid.Column="1"
                                               Text="SIL Open Font License 1.1"
                                               Tag="OFL-Exo2.txt"
                                               MouseLeftButtonUp="OnShowLicense"
                                               AutomationProperties.Name="Exo 2 License"
                                               Style="{StaticResource LicenseLinkTextStyle}" />

                                    <TextBlock Grid.Row="6"
                                               Text="Share Tech Mono"
                                               Style="{StaticResource BodyTextStyle}"
                                               FontSize="19"
                                               Foreground="#D8F8FF" />
                                    <TextBlock Grid.Row="6"
                                               Grid.Column="1"
                                               Text="SIL Open Font License 1.1"
                                               Tag="OFL-ShareTechMono.txt"
                                               MouseLeftButtonUp="OnShowLicense"
                                               AutomationProperties.Name="Share Tech Mono License"
                                               Style="{StaticResource LicenseLinkTextStyle}" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Button Grid.Row="2"
                                Content="Close"
                                Click="OnCloseCredits"
                                HorizontalAlignment="Center"
                                AutomationProperties.Name="Close Credits"
                                Style="{StaticResource SettingsButtonStyle}" />
                    </Grid>
                </Grid>
            </Viewbox>

            <Grid x:Name="LicensePopup"
                  Visibility="Collapsed"
                  Background="#CC00040A">
                <Border Width="1180"
                        Height="760"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#F0061521"
                        BorderBrush="#8CE8FF"
                        BorderThickness="2"
                        Padding="34">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="LicensePopupTitle"
                                   Style="{StaticResource SectionHeaderTextStyle}"
                                   FontSize="34"
                                   Foreground="#D8F8FF"
                                   TextWrapping="Wrap" />

                        <ScrollViewer Grid.Row="1"
                                      Margin="0,24,0,24"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="LicensePopupBody"
                                       Style="{StaticResource BodyTextStyle}"
                                       FontSize="18"
                                       LineHeight="25"
                                       Foreground="#EAFBFF"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>

                        <Button Grid.Row="2"
                                Content="Close"
                                Click="OnCloseLicensePopup"
                                HorizontalAlignment="Center"
                                AutomationProperties.Name="Close License"
                                Style="{StaticResource SettingsButtonStyle}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
