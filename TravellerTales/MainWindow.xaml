<Window x:Class="TravellerTales.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TravellerTales.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Traveller Tales"
        MinHeight="720"
        MinWidth="1280"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Icon="pack://application:,,,/Assets/icon.ico"
        Background="Black"
        Foreground="{StaticResource AppForegroundBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="LandingPolygonButtonStyle" TargetType="{x:Type controls:PolygonButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HoverFill" Value="#224AA3FF" />
            <Setter Property="HoverStroke" Value="Transparent" />
            <Setter Property="PressedFill" Value="#334AA3FF" />
            <Setter Property="ShapeFill" Value="#55FF3B30" />
            <Setter Property="ShapeStroke" Value="Transparent" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:PolygonButton}">
                        <ContentPresenter HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlaceholderButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Padding" Value="22,8" />
            <Setter Property="Background" Value="#151D2A" />
            <Setter Property="BorderBrush" Value="#4FA7FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#EAF6FF" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Background="Black">
        <Grid x:Name="LandingView" Visibility="Visible">
            <Viewbox Stretch="UniformToFill"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch">
                <Grid Width="1672"
                      Height="941"
                      IsHitTestVisible="True">
                    <Image Source="pack://application:,,,/Assets/landing.png"
                           Stretch="Fill" />

                    <controls:PolygonButton x:Name="ContinueButton"
                                            Width="1672"
                                            Height="941"
                                            IsEnabled="False"
                                            AutomationProperties.Name="Continue"
                                            ToolTip="Continue will be available when an in-progress character exists."
                                            ToolTipService.ShowOnDisabled="True"
                                            ShapeFill="#55FF3B30"
                                            ShapeStroke="Transparent"
                                            ShapeData="M 1248,117 L 1599,117 L 1624,144 L 1614,191 L 1582,219 L 1241,219 L 1216,194 L 1220,143 Z"
                                            Style="{StaticResource LandingPolygonButtonStyle}" />
                    <controls:PolygonButton Width="1672"
                                            Height="941"
                                            Click="OnNewCharacter"
                                            AutomationProperties.Name="New Character"
                                            ToolTip="New Character"
                                            ShapeFill="#5500C853"
                                            ShapeStroke="Transparent"
                                            ShapeData="M 1239,221 L 1588,224 L 1610,249 L 1601,287 L 1574,306 L 1232,306 L 1205,283 L 1210,247 Z"
                                            Style="{StaticResource LandingPolygonButtonStyle}" />
                    <controls:PolygonButton Width="1672"
                                            Height="941"
                                            Click="OnEditNarratives"
                                            AutomationProperties.Name="Edit Narratives"
                                            ToolTip="Edit Narratives"
                                            ShapeFill="#552978FF"
                                            ShapeStroke="Transparent"
                                            ShapeData="M 1230,311 L 1580,315 L 1604,340 L 1595,378 L 1566,397 L 1224,395 L 1197,373 L 1202,335 Z"
                                            Style="{StaticResource LandingPolygonButtonStyle}" />
                    <controls:PolygonButton Width="1672"
                                            Height="941"
                                            Click="OnSettings"
                                            AutomationProperties.Name="Settings"
                                            ToolTip="Settings"
                                            ShapeFill="#55FFD600"
                                            ShapeStroke="Transparent"
                                            ShapeData="M 1222,400 L 1572,406 L 1596,432 L 1587,470 L 1558,488 L 1216,485 L 1188,462 L 1194,425 Z"
                                            Style="{StaticResource LandingPolygonButtonStyle}" />
                    <controls:PolygonButton Width="1672"
                                            Height="941"
                                            Click="OnCredits"
                                            AutomationProperties.Name="Credits"
                                            ToolTip="Credits"
                                            ShapeFill="#55D500F9"
                                            ShapeStroke="Transparent"
                                            ShapeData="M 1215,489 L 1565,497 L 1589,523 L 1580,560 L 1552,578 L 1208,574 L 1181,551 L 1187,513 Z"
                                            Style="{StaticResource LandingPolygonButtonStyle}" />
                    <controls:PolygonButton Width="1672"
                                            Height="941"
                                            Click="OnExit"
                                            AutomationProperties.Name="Exit"
                                            ToolTip="Exit"
                                            ShapeFill="#55FF6D00"
                                            ShapeStroke="Transparent"
                                            ShapeData="M 1208,578 L 1558,586 L 1582,612 L 1573,650 L 1545,668 L 1201,664 L 1174,640 L 1180,602 Z"
                                            Style="{StaticResource LandingPolygonButtonStyle}" />
                </Grid>
            </Viewbox>
        </Grid>

        <Grid x:Name="PlaceholderView"
              Visibility="Collapsed"
              Background="#EE05080F">
            <Grid MaxWidth="1180"
                  Margin="72"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="PlaceholderTitle"
                           Text="Placeholder"
                           FontSize="54"
                           FontWeight="SemiBold"
                           Foreground="#EAF6FF" />
                <TextBlock x:Name="PlaceholderBody"
                           Grid.Row="1"
                           Margin="0,22,0,34"
                           TextWrapping="Wrap"
                           FontSize="24"
                           LineHeight="34"
                           Foreground="#BEDFFF" />
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal">
                    <Button Content="Back"
                            Click="OnBackToLanding"
                            AutomationProperties.Name="Back"
                            Style="{StaticResource PlaceholderButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
