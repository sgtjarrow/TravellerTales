<Window x:Class="TravellerTales.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Traveller Tales"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Icon="pack://application:,,,/Assets/icon.ico"
        Background="Black"
        ShowInTaskbar="False"
        FontFamily="{StaticResource BodyTextFontFamily}">
    <Grid Background="Black">
        <Image Source="pack://application:,,,/Assets/captains_guild.png"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />

        <Grid Background="#33000000" />

        <StackPanel Margin="80,72,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
            <TextBlock Text="Traveller Tales"
                       Style="{StaticResource AppTitleTextStyle}"
                       Foreground="#F6F2EA"
                       FontSize="128"
                       FontWeight="Bold" />
            <TextBlock Text="Loading local archives..."
                       Style="{StaticResource BodyTextStyle}"
                       Foreground="#D8D2C8"
                       FontSize="30"
                       Margin="8,10,0,0" />
        </StackPanel>
    </Grid>
</Window>
