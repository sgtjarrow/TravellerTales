<Window x:Class="TravellerTales.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Traveller Tales"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Icon="pack://application:,,,/Assets/icon.ico"
        Background="Black"
        ShowInTaskbar="False"
        FontFamily="Segoe UI">
    <Grid Background="Black">
        <Image Source="pack://application:,,,/Assets/captains_guild.png"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />

        <Grid Background="#33000000" />

        <StackPanel Margin="72"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom">
            <TextBlock Text="Traveller Tales"
                       Foreground="#F6F2EA"
                       FontSize="64"
                       FontWeight="SemiBold" />
            <TextBlock Text="Loading local archives..."
                       Foreground="#D8D2C8"
                       FontSize="24"
                       Margin="4,8,0,0" />
        </StackPanel>
    </Grid>
</Window>
