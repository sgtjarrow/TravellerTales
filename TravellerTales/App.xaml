<Application x:Class="TravellerTales.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="OnStartup">
    <Application.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#050505" />
        <SolidColorBrush x:Key="AppForegroundBrush" Color="#F6F2EA" />
        <SolidColorBrush x:Key="AppAccentBrush" Color="#C99A45" />
        <FontFamily x:Key="AppTitleFontFamily">Orbitron, Bahnschrift SemiBold, Segoe UI Semibold</FontFamily>
        <FontFamily x:Key="SectionHeaderFontFamily">Rajdhani, Bahnschrift SemiBold, Segoe UI Semibold</FontFamily>
        <FontFamily x:Key="LabelButtonFontFamily">Rajdhani, Bahnschrift, Segoe UI</FontFamily>
        <FontFamily x:Key="BodyTextFontFamily">Exo 2, Segoe UI</FontFamily>
        <FontFamily x:Key="DataFieldFontFamily">Share Tech Mono, Consolas</FontFamily>

        <Style x:Key="AppTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppTitleFontFamily}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
        </Style>

        <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SectionHeaderFontFamily}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
        </Style>

        <Style x:Key="BodyTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BodyTextFontFamily}" />
            <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
        </Style>

        <Style x:Key="DataFieldTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DataFieldFontFamily}" />
            <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
        </Style>

        <Style x:Key="LandingButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Padding" Value="22,10" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="#1B1B1B" />
            <Setter Property="BorderBrush" Value="#4A3D2F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource LabelButtonFontFamily}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A241E" />
                                <Setter Property="BorderBrush" Value="{StaticResource AppAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3A2F22" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
