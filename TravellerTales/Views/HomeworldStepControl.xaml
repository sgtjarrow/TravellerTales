<UserControl x:Class="TravellerTales.Views.HomeworldStepControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1240">
    <UserControl.Resources>
        <Style x:Key="WizardLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderTextStyle}">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Foreground" Value="#9FEFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="WizardTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#D0071523" />
            <Setter Property="BorderBrush" Value="#5FD9FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Setter Property="CaretBrush" Value="#EAFBFF" />
            <Setter Property="FontFamily" Value="{StaticResource DataFieldFontFamily}" />
            <Setter Property="FontSize" Value="20" />
        </Style>

        <Style x:Key="HomeworldUwpCodeButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="20" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="#A0071523" />
            <Setter Property="BorderBrush" Value="#5FD9FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Setter Property="FontFamily" Value="{StaticResource DataFieldFontFamily}" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="RandomNameButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="#D0071523" />
            <Setter Property="BorderBrush" Value="#5FD9FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Setter Property="FontFamily" Value="{StaticResource LabelButtonFontFamily}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#C806111E"
                BorderBrush="#5FD9FF"
                BorderThickness="1"
                Padding="26">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="185" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="NAME"
                           Style="{StaticResource WizardLabelStyle}" />
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="HomeworldNameTextBox"
                             Style="{StaticResource WizardTextBoxStyle}"
                             TextChanged="OnFieldChanged" />
                    <Button Grid.Column="2"
                            Content="?"
                            Style="{StaticResource RandomNameButtonStyle}"
                            ToolTip="Generate Random Homeworld Name"
                            Click="OnGenerateName" />
                </Grid>

                <TextBlock Grid.Row="2"
                           Text="CANDIDATES"
                           Style="{StaticResource WizardLabelStyle}"
                           VerticalAlignment="Top"
                           Margin="0,8,0,0" />

                <UniformGrid Grid.Row="2"
                             Grid.Column="1"
                             Columns="3">
                    <Border x:Name="CandidateOneCard"
                            Tag="0"
                            Margin="0,0,14,0"
                            Padding="20"
                            Background="#D006111E"
                            BorderBrush="#5FD9FF"
                            BorderThickness="1"
                            Cursor="Hand"
                            MouseLeftButtonUp="OnCandidateSelected">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="UWP"
                                           Style="{StaticResource SectionHeaderTextStyle}"
                                           FontSize="18"
                                           Foreground="#9FEFFF"
                                           VerticalAlignment="Center" />
                                <UniformGrid Grid.Column="2"
                                             Columns="9">
                                    <Button x:Name="CandidateOneStarportCodeButton"
                                            Tag="0|Starport"
                                            Style="{StaticResource HomeworldUwpCodeButtonStyle}"
                                            Click="OnUwpCodeClicked" />
                                    <Button x:Name="CandidateOneWorldSizeCodeButton"
                                            Tag="0|WorldSize"
                                            Style="{StaticResource HomeworldUwpCodeButtonStyle}"
                                            Click="OnUwpCodeClicked" />
                                    <Button x:Name="CandidateOneAtmosphereCodeButton"
                                            Tag="0|Atmosphere"
                                            Style="{StaticResource HomeworldUwpCodeButtonStyle}"
                                            Click="OnUwpCodeClicked" />
                                    <Button x:Name="CandidateOneHydrographicsCodeButton"
                                            Tag="0|Hydrographics"
                                            Style="{StaticResource HomeworldUwpCodeButtonStyle}"
                                            Click="OnUwpCodeClicked" />
                                    <Button x:Name="CandidateOnePopulationCodeButton"
                                            Tag="0|Population"
                                            Style="{StaticResource HomeworldUwpCodeButtonStyle}"
                                            Click="OnUwpCodeClicked" />
                                    <Button x:Name="CandidateOneGovernmentCodeButton"
                                            Tag="0|Government"
                                            Style="{StaticResource HomeworldUwpCodeButtonStyle}"
                                            Click="OnUwpCodeClicked" />
                                    <Button x:Name="CandidateOneLawLevelCodeButton"
                                            Tag="0|LawLevel"
                                            Style="{StaticResource HomeworldUwpCodeButtonStyle}"
                                            Click="OnUwpCodeClicked" />
                                    <TextBlock Text="-"
                                               Style="{StaticResource BodyTextStyle}"
                                               FontFamily="{StaticResource DataFieldFontFamily}"
                                               FontSize="23"
                                               Foreground="#EAFBFF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Button x:Name="CandidateOneTechLevelCodeButton"
                                            Tag="0|TechLevel"
                                            Style="{StaticResource HomeworldUwpCodeButtonStyle}"
                                            Click="OnUwpCodeClicked" />
                                </UniformGrid>
                            </Grid>
                            <ScrollViewer x:Name="CandidateOneDetailScrollViewer"
                                          Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="CandidateOneDetailText"
                                           Style="{StaticResource BodyTextStyle}"
                                           FontSize="18"
                                           LineHeight="25"
                                           Foreground="#BEDFFF"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border x:Name="CandidateTwoCard"
                            Tag="1"
                            Margin="7,0"
                            Padding="20"
                            Background="#D006111E"
                            BorderBrush="#5FD9FF"
                            BorderThickness="1"
                            Cursor="Hand"
                            MouseLeftButtonUp="OnCandidateSelected">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="UWP"
                                           Style="{StaticResource SectionHeaderTextStyle}"
                                           FontSize="18"
                                           Foreground="#9FEFFF"
                                           VerticalAlignment="Center" />
                                <UniformGrid Grid.Column="2"
                                             Columns="9">
                                    <Button x:Name="CandidateTwoStarportCodeButton"
                                            Tag="1|Starport"
                                            Style="{StaticResource HomeworldUwpCodeButtonStyle}"
                                            Click="OnUwpCodeClicked" />
                                    <Button x:Name="CandidateTwoWorldSizeCodeButton"
                                            Tag="1|WorldSize"
                                            Style="{StaticResource HomeworldUwpCodeButtonStyle}"
                                            Click="OnUwpCodeClicked" />
                                    <Button x:Name="CandidateTwoAtmosphereCodeButton"
                                            Tag="1|Atmosphere"
                                            Style="{StaticResource HomeworldUwpCodeButtonStyle}"
                                            Click="OnUwpCodeClicked" />
                                    <Button x:Name="CandidateTwoHydrographicsCodeButton"
                                            Tag="1|Hydrographics"
                                            Style="{StaticResource HomeworldUwpCodeButtonStyle}"
                                            Click="OnUwpCodeClicked" />
                                    <Button x:Name="CandidateTwoPopulationCodeButton"
                                            Tag="1|Population"
                                            Style="{StaticResource HomeworldUwpCodeButtonStyle}"
                                            Click="OnUwpCodeClicked" />
                                    <Button x:Name="CandidateTwoGovernmentCodeButton"
                                            Tag="1|Government"
                                            Style="{StaticResource HomeworldUwpCodeButtonStyle}"
                                            Click="OnUwpCodeClicked" />
                                    <Button x:Name="CandidateTwoLawLevelCodeButton"
                                            Tag="1|LawLevel"
                                            Style="{StaticResource HomeworldUwpCodeButtonStyle}"
                                            Click="OnUwpCodeClicked" />
                                    <TextBlock Text="-"
                                               Style="{StaticResource BodyTextStyle}"
                                               FontFamily="{StaticResource DataFieldFontFamily}"
                                               FontSize="23"
                                               Foreground="#EAFBFF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Button x:Name="CandidateTwoTechLevelCodeButton"
                                            Tag="1|TechLevel"
                                            Style="{StaticResource HomeworldUwpCodeButtonStyle}"
                                            Click="OnUwpCodeClicked" />
                                </UniformGrid>
                            </Grid>
                            <ScrollViewer x:Name="CandidateTwoDetailScrollViewer"
                                          Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="CandidateTwoDetailText"
                                           Style="{StaticResource BodyTextStyle}"
                                           FontSize="18"
                                           LineHeight="25"
                                           Foreground="#BEDFFF"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border x:Name="CandidateThreeCard"
                            Tag="2"
                            Margin="14,0,0,0"
                            Padding="20"
                            Background="#D006111E"
                            BorderBrush="#5FD9FF"
                            BorderThickness="1"
                            Cursor="Hand"
                            MouseLeftButtonUp="OnCandidateSelected">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="UWP"
                                           Style="{StaticResource SectionHeaderTextStyle}"
                                           FontSize="18"
                                           Foreground="#9FEFFF"
                                           VerticalAlignment="Center" />
                                <UniformGrid Grid.Column="2"
                                             Columns="9">
                                    <Button x:Name="CandidateThreeStarportCodeButton"
                                            Tag="2|Starport"
                                            Style="{StaticResource HomeworldUwpCodeButtonStyle}"
                                            Click="OnUwpCodeClicked" />
                                    <Button x:Name="CandidateThreeWorldSizeCodeButton"
                                            Tag="2|WorldSize"
                                            Style="{StaticResource HomeworldUwpCodeButtonStyle}"
                                            Click="OnUwpCodeClicked" />
                                    <Button x:Name="CandidateThreeAtmosphereCodeButton"
                                            Tag="2|Atmosphere"
                                            Style="{StaticResource HomeworldUwpCodeButtonStyle}"
                                            Click="OnUwpCodeClicked" />
                                    <Button x:Name="CandidateThreeHydrographicsCodeButton"
                                            Tag="2|Hydrographics"
                                            Style="{StaticResource HomeworldUwpCodeButtonStyle}"
                                            Click="OnUwpCodeClicked" />
                                    <Button x:Name="CandidateThreePopulationCodeButton"
                                            Tag="2|Population"
                                            Style="{StaticResource HomeworldUwpCodeButtonStyle}"
                                            Click="OnUwpCodeClicked" />
                                    <Button x:Name="CandidateThreeGovernmentCodeButton"
                                            Tag="2|Government"
                                            Style="{StaticResource HomeworldUwpCodeButtonStyle}"
                                            Click="OnUwpCodeClicked" />
                                    <Button x:Name="CandidateThreeLawLevelCodeButton"
                                            Tag="2|LawLevel"
                                            Style="{StaticResource HomeworldUwpCodeButtonStyle}"
                                            Click="OnUwpCodeClicked" />
                                    <TextBlock Text="-"
                                               Style="{StaticResource BodyTextStyle}"
                                               FontFamily="{StaticResource DataFieldFontFamily}"
                                               FontSize="23"
                                               Foreground="#EAFBFF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Button x:Name="CandidateThreeTechLevelCodeButton"
                                            Tag="2|TechLevel"
                                            Style="{StaticResource HomeworldUwpCodeButtonStyle}"
                                            Click="OnUwpCodeClicked" />
                                </UniformGrid>
                            </Grid>
                            <ScrollViewer x:Name="CandidateThreeDetailScrollViewer"
                                          Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="CandidateThreeDetailText"
                                           Style="{StaticResource BodyTextStyle}"
                                           FontSize="18"
                                           LineHeight="25"
                                           Foreground="#BEDFFF"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </UniformGrid>

                <TextBlock Grid.Row="4"
                           Text="NOTES"
                           Style="{StaticResource WizardLabelStyle}"
                           VerticalAlignment="Top"
                           Margin="0,8,0,0" />
                <TextBox x:Name="HomeworldNotesTextBox"
                         Grid.Row="4"
                         Grid.Column="1"
                         Height="112"
                         MinHeight="112"
                         Padding="12"
                         VerticalContentAlignment="Top"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Style="{StaticResource WizardTextBoxStyle}"
                         TextChanged="OnFieldChanged" />
            </Grid>
        </Border>

        <TextBlock x:Name="ValidationMessage"
                   Grid.Row="1"
                   Margin="0,18,0,0"
                   Style="{StaticResource BodyTextStyle}"
                   FontSize="20"
                   Foreground="#FFB36A"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center" />
    </Grid>
</UserControl>
