<Window x:Class="TravellerTales.Views.CareerTermDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Career Term"
        Width="980"
        Height="820"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource AppForegroundBrush}"
        FontFamily="{StaticResource BodyTextFontFamily}"
        Closing="OnClosing">
    <Window.Resources>
        <Style x:Key="TermButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="126" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="18,6" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="#CC061521" />
            <Setter Property="BorderBrush" Value="#8CE8FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Setter Property="FontFamily" Value="{StaticResource LabelButtonFontFamily}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DD0D2A3C" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#C9F5FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EE174A64" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#CC2A0610" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#7A1E1E" />
                                <Setter Property="Foreground" Value="#8B9AA2" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TermComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="220" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#D0071523" />
            <Setter Property="BorderBrush" Value="#5FD9FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Setter Property="FontFamily" Value="{StaticResource DataFieldFontFamily}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="38" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Margin="{TemplateBinding Padding}"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <ToggleButton x:Name="DropdownToggle"
                                                  Grid.Column="1"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="Transparent"
                                                  BorderBrush="Transparent"
                                                  BorderThickness="0"
                                                  Foreground="#DFFBFF"
                                                  FontFamily="{StaticResource LabelButtonFontFamily}"
                                                  FontSize="16"
                                                  Content="v"
                                                  Cursor="Hand">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#F0061521"
                                        BorderBrush="#5FD9FF"
                                        BorderThickness="1">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#C9F5FF" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBorder" Property="Background" Value="#DD0D2A3C" />
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#C9F5FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder" Property="Background" Value="#B0061521" />
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#3D8EAA" />
                                <Setter TargetName="DropdownToggle" Property="Foreground" Value="#6FB9CA" />
                                <Setter TargetName="DropdownToggle" Property="Background" Value="#400D3144" />
                                <Setter Property="Foreground" Value="#BFEAF2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TermComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#F0061521" />
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Setter Property="FontFamily" Value="{StaticResource DataFieldFontFamily}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="12,7" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#DD1A5574" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CC12344A" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#8B9AA2" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#6600040A"
            Padding="12">
        <Border Background="#F0061521"
                BorderBrush="#8CE8FF"
                BorderThickness="2"
                Padding="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TitleText"
                               Text="CAREER TERM"
                               Style="{StaticResource SectionHeaderTextStyle}"
                               FontSize="31"
                               Foreground="#D8F8FF"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />

                    <TextBlock x:Name="StepText"
                               Grid.Column="1"
                               Style="{StaticResource DataFieldTextStyle}"
                               FontSize="20"
                               Foreground="#9FEFFF"
                               VerticalAlignment="Center" />
                </Grid>

                <Rectangle Grid.Row="1"
                           Height="1"
                           Margin="0,17,0,0"
                           Fill="#447EDBFF" />

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border x:Name="CareerSection" Padding="16" Margin="0,0,0,10" BorderThickness="1" Background="#99071523">
                            <StackPanel>
                                <TextBlock Text="Career" Style="{StaticResource SectionHeaderTextStyle}" FontSize="21" Foreground="#EAFBFF" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <ComboBox x:Name="CareerComboBox"
                                              SelectionChanged="OnCareerSelectionChanged"
                                              Style="{StaticResource TermComboBoxStyle}"
                                              ItemContainerStyle="{StaticResource TermComboBoxItemStyle}" />
                                    <Button x:Name="CareerButton" Content="Select Career" Click="OnSelectCareer" Style="{StaticResource TermButtonStyle}" />
                                    <Button x:Name="QualificationButton" Content="Roll Qualification" Click="OnRollQualification" Style="{StaticResource TermButtonStyle}" />
                                    <Button x:Name="DraftButton" Content="Submit to Draft" Click="OnSubmitToDraft" Style="{StaticResource TermButtonStyle}" />
                                    <Button x:Name="DrifterButton" Content="Enter Drifter" Click="OnEnterDrifter" Style="{StaticResource TermButtonStyle}" />
                                </StackPanel>
                                <TextBlock x:Name="CareerDetailText" Style="{StaticResource DataFieldTextStyle}" FontSize="18" Foreground="#BEDFFF" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <TextBlock x:Name="CareerResultText" Style="{StaticResource DataFieldTextStyle}" FontSize="18" Foreground="#BEDFFF" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="AssignmentSection" Padding="16" Margin="0,0,0,10" BorderThickness="1" Background="#99071523">
                            <StackPanel>
                                <TextBlock Text="Assignment" Style="{StaticResource SectionHeaderTextStyle}" FontSize="21" Foreground="#EAFBFF" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <ComboBox x:Name="AssignmentComboBox"
                                              SelectionChanged="OnAssignmentSelectionChanged"
                                              Style="{StaticResource TermComboBoxStyle}"
                                              ItemContainerStyle="{StaticResource TermComboBoxItemStyle}" />
                                    <Button x:Name="AssignmentButton" Content="Select Assignment" Click="OnSelectAssignment" Style="{StaticResource TermButtonStyle}" />
                                </StackPanel>
                                <TextBlock x:Name="AssignmentDetailText" Style="{StaticResource DataFieldTextStyle}" FontSize="18" Foreground="#BEDFFF" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <TextBlock x:Name="AssignmentResultText" Style="{StaticResource DataFieldTextStyle}" FontSize="18" Foreground="#BEDFFF" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="TrainingSection" Padding="16" Margin="0,0,0,10" BorderThickness="1" Background="#99071523">
                            <StackPanel>
                                <TextBlock x:Name="TrainingTitleText" Text="Training" Style="{StaticResource SectionHeaderTextStyle}" FontSize="21" Foreground="#EAFBFF" />
                                <Button x:Name="TrainingButton" Content="Resolve Training" Click="OnResolveTraining" HorizontalAlignment="Left" Margin="0,10,0,0" Style="{StaticResource TermButtonStyle}" />
                                <TextBlock x:Name="TrainingResultText" Style="{StaticResource DataFieldTextStyle}" FontSize="18" Foreground="#BEDFFF" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="SurvivalSection" Padding="16" Margin="0,0,0,10" BorderThickness="1" Background="#99071523">
                            <StackPanel>
                                <TextBlock Text="Survival" Style="{StaticResource SectionHeaderTextStyle}" FontSize="21" Foreground="#EAFBFF" />
                                <Button x:Name="SurvivalButton" Content="Roll Survival" Click="OnRollSurvival" HorizontalAlignment="Left" Margin="0,10,0,0" Style="{StaticResource TermButtonStyle}" />
                                <TextBlock x:Name="SurvivalResultText" Style="{StaticResource DataFieldTextStyle}" FontSize="18" Foreground="#BEDFFF" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="MishapSection" Padding="16" Margin="0,0,0,10" BorderThickness="1" Background="#99071523">
                            <StackPanel>
                                <TextBlock Text="Mishap" Style="{StaticResource SectionHeaderTextStyle}" FontSize="21" Foreground="#EAFBFF" />
                                <Button x:Name="MishapButton" Content="Roll Mishap" Click="OnResolveMishap" HorizontalAlignment="Left" Margin="0,10,0,0" Style="{StaticResource TermButtonStyle}" />
                                <TextBlock x:Name="MishapResultText" Style="{StaticResource DataFieldTextStyle}" FontSize="18" Foreground="#BEDFFF" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="EventSection" Padding="16" Margin="0,0,0,10" BorderThickness="1" Background="#99071523">
                            <StackPanel>
                                <TextBlock Text="Event" Style="{StaticResource SectionHeaderTextStyle}" FontSize="21" Foreground="#EAFBFF" />
                                <Button x:Name="EventButton" Content="Roll Event" Click="OnRollEvent" HorizontalAlignment="Left" Margin="0,10,0,0" Style="{StaticResource TermButtonStyle}" />
                                <TextBlock x:Name="EventResultText" Style="{StaticResource DataFieldTextStyle}" FontSize="18" Foreground="#BEDFFF" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="AdvancementSection" Padding="16" Margin="0,0,0,10" BorderThickness="1" Background="#99071523">
                            <StackPanel>
                                <TextBlock Text="Commission / Advancement" Style="{StaticResource SectionHeaderTextStyle}" FontSize="21" Foreground="#EAFBFF" />
                                <Button x:Name="AdvancementButton" Content="Roll Commission / Advancement" Click="OnRollAdvancement" HorizontalAlignment="Left" Margin="0,10,0,0" Style="{StaticResource TermButtonStyle}" />
                                <TextBlock x:Name="AdvancementResultText" Style="{StaticResource DataFieldTextStyle}" FontSize="18" Foreground="#BEDFFF" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="LeavingSection" Padding="16" Margin="0,0,0,10" BorderThickness="1" Background="#99071523">
                            <StackPanel>
                                <TextBlock Text="Career Decision" Style="{StaticResource SectionHeaderTextStyle}" FontSize="21" Foreground="#EAFBFF" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="ContinueCareerButton" Content="Continue Career" Click="OnContinueCareer" Style="{StaticResource TermButtonStyle}" />
                                    <Button x:Name="LeaveCareerButton" Content="Leave Career" Click="OnLeaveCareer" Style="{StaticResource TermButtonStyle}" />
                                </StackPanel>
                                <TextBlock x:Name="LeavingResultText" Style="{StaticResource DataFieldTextStyle}" FontSize="18" Foreground="#BEDFFF" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="MusteringSection" Padding="16" Margin="0,0,0,10" BorderThickness="1" Background="#99071523">
                            <StackPanel>
                                <TextBlock Text="Mustering Out" Style="{StaticResource SectionHeaderTextStyle}" FontSize="21" Foreground="#EAFBFF" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="CashBenefitButton" Content="Cash Benefit" Click="OnCashBenefit" Style="{StaticResource TermButtonStyle}" />
                                    <Button x:Name="MaterialBenefitButton" Content="Material Benefit" Click="OnMaterialBenefit" Style="{StaticResource TermButtonStyle}" />
                                </StackPanel>
                                <TextBlock x:Name="MusteringResultText" Style="{StaticResource DataFieldTextStyle}" FontSize="18" Foreground="#BEDFFF" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="AgingSection" Padding="16" Margin="0,0,0,10" BorderThickness="1" Background="#99071523">
                            <StackPanel>
                                <TextBlock Text="Aging" Style="{StaticResource SectionHeaderTextStyle}" FontSize="21" Foreground="#EAFBFF" />
                                <Button x:Name="AgingButton" Content="Resolve Aging" Click="OnResolveAging" HorizontalAlignment="Left" Margin="0,10,0,0" Style="{StaticResource TermButtonStyle}" />
                                <TextBlock x:Name="AgingResultText" Style="{StaticResource DataFieldTextStyle}" FontSize="18" Foreground="#BEDFFF" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Rectangle Grid.Row="3"
                           Height="1"
                           Margin="0,17,0,0"
                           Fill="#447EDBFF" />

                <Grid Grid.Row="4">
                    <TextBlock x:Name="ValidationText"
                               Style="{StaticResource BodyTextStyle}"
                               FontSize="18"
                               Foreground="#FFB36A"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="CancelButton"
                                Content="Cancel Character Creation"
                                Click="OnCancelCharacterCreation"
                                Style="{StaticResource TermButtonStyle}" />
                        <Button x:Name="CompleteButton"
                                Content="Complete Term"
                                Click="OnCompleteTerm"
                                Style="{StaticResource TermButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
