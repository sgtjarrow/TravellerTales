<Window x:Class="TravellerTales.Views.SkillSelectorDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TravellerTales.Views"
        Title="Select Skill"
        Width="760"
        Height="680"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource AppForegroundBrush}"
        FontFamily="{StaticResource BodyTextFontFamily}"
        KeyDown="OnKeyDown">
    <Window.Resources>
        <local:DisabledReasonToolTipConverter x:Key="DisabledReasonToolTipConverter" />

        <Style x:Key="SelectorButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="126" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="22,8" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="Background" Value="#CC061521" />
            <Setter Property="BorderBrush" Value="#8CE8FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Setter Property="FontFamily" Value="{StaticResource LabelButtonFontFamily}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DD0D2A3C" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#C9F5FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EE174A64" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#CC2A0610" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#7A1E1E" />
                                <Setter Property="Foreground" Value="#8B9AA2" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogCloseButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="18,0,0,0" />
            <Setter Property="Background" Value="#CC2A0610" />
            <Setter Property="BorderBrush" Value="#FF6B6B" />
            <Setter Property="Foreground" Value="#FF9A9A" />
            <Setter Property="FontFamily" Value="{StaticResource LabelButtonFontFamily}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DD4A0A14" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF9A9A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EE6B101C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelectorListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="#D0071523" />
            <Setter Property="BorderBrush" Value="#5FD9FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Setter Property="FontFamily" Value="{StaticResource DataFieldFontFamily}" />
            <Setter Property="FontSize" Value="20" />
        </Style>

        <Style x:Key="SelectorListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
            <Setter Property="ToolTip" Value="{Binding DisabledReason, Converter={StaticResource DisabledReasonToolTipConverter}}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#8B9AA2" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CC12344A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SelectorComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
            <Setter Property="ToolTip" Value="{Binding DisabledReason, Converter={StaticResource DisabledReasonToolTipConverter}}" />
            <Setter Property="Background" Value="#F0061521" />
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Setter Property="FontFamily" Value="{StaticResource DataFieldFontFamily}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="12,7" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#DD1A5574" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CC12344A" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#8B9AA2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SelectorComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#D0071523" />
            <Setter Property="BorderBrush" Value="#5FD9FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource DataFieldFontFamily}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="38" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Margin="{TemplateBinding Padding}"
                                               Text="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource TemplatedParent}}"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center" />

                                    <ToggleButton x:Name="DropdownToggle"
                                                  Grid.Column="1"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="Transparent"
                                                  BorderBrush="Transparent"
                                                  BorderThickness="0"
                                                  Foreground="#DFFBFF"
                                                  FontFamily="{StaticResource LabelButtonFontFamily}"
                                                  FontSize="16"
                                                  Content="v"
                                                  Cursor="Hand">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#F0061521"
                                        BorderBrush="#5FD9FF"
                                        BorderThickness="1">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#C9F5FF" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBorder" Property="Background" Value="#DD0D2A3C" />
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#C9F5FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder" Property="Background" Value="#B0061521" />
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#3D8EAA" />
                                <Setter TargetName="DropdownToggle" Property="Foreground" Value="#6FB9CA" />
                                <Setter TargetName="DropdownToggle" Property="Background" Value="#400D3144" />
                                <Setter Property="Foreground" Value="#BFEAF2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelectorTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#D0071523" />
            <Setter Property="BorderBrush" Value="#5FD9FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Setter Property="FontFamily" Value="{StaticResource DataFieldFontFamily}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
    </Window.Resources>

    <Border Background="#6600040A"
            Padding="12">
        <Border Background="#F0061521"
                BorderBrush="#8CE8FF"
                BorderThickness="2"
                Padding="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TitleText"
                               Style="{StaticResource SectionHeaderTextStyle}"
                               FontSize="31"
                               Foreground="#D8F8FF"
                               Text="SELECT SKILL"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="1"
                            Content="X"
                            Click="OnCancel"
                            AutomationProperties.Name="Close Skill Selector"
                            Style="{StaticResource DialogCloseButtonStyle}" />
                </Grid>

                <Rectangle Grid.Row="1"
                           Height="1"
                           Margin="0,17,0,0"
                           Fill="#447EDBFF" />

                <TextBlock x:Name="ActionText"
                           Grid.Row="2"
                           Style="{StaticResource BodyTextStyle}"
                           FontSize="18"
                           Foreground="#BEDFFF"
                           TextWrapping="Wrap" />

                <Grid Grid.Row="4">
                    <Grid.Margin>
                        <Thickness Top="4" />
                    </Grid.Margin>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="SKILLS"
                                   Style="{StaticResource SectionHeaderTextStyle}"
                                   FontSize="22"
                                   Foreground="#9FEFFF" />

                        <ListBox x:Name="SkillList"
                                 Grid.Row="2"
                                 SelectionChanged="OnSkillSelectionChanged"
                                 Style="{StaticResource SelectorListBoxStyle}"
                                 ItemContainerStyle="{StaticResource SelectorListBoxItemStyle}"
                                 DisplayMemberPath="DisplayName" />
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="SPECIALTY"
                                   Grid.Row="1"
                                   Style="{StaticResource SectionHeaderTextStyle}"
                                   FontSize="22"
                                   Foreground="#9FEFFF" />

                        <TextBlock x:Name="SpecialtyPromptText"
                                   Grid.Row="3"
                                   Style="{StaticResource BodyTextStyle}"
                                   FontSize="18"
                                   Foreground="#BEDFFF"
                                   VerticalAlignment="Top"
                                   TextWrapping="Wrap" />

                        <ComboBox x:Name="SpecialtyComboBox"
                                  Grid.Row="5"
                                  DisplayMemberPath="DisplayName"
                                  Style="{StaticResource SelectorComboBoxStyle}"
                                  ItemContainerStyle="{StaticResource SelectorComboBoxItemStyle}"
                                  SelectionChanged="OnSpecialtySelectionChanged" />

                        <TextBox x:Name="CustomSpecialtyTextBox"
                                 Grid.Row="7"
                                 Height="42"
                                 VerticalAlignment="Top"
                                 TextChanged="OnCustomSpecialtyChanged"
                                 Style="{StaticResource SelectorTextBoxStyle}" />
                    </Grid>
                </Grid>

                <TextBlock x:Name="ValidationText"
                           Grid.Row="6"
                           Style="{StaticResource BodyTextStyle}"
                           FontSize="18"
                           Foreground="#FFB36A"
                           TextWrapping="Wrap" />

                <StackPanel Grid.Row="8"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Click="OnCancel"
                            AutomationProperties.Name="Cancel Skill Selection"
                            Style="{StaticResource SelectorButtonStyle}" />
                    <Button Content="OK"
                            Click="OnOk"
                            AutomationProperties.Name="Confirm Skill Selection"
                            Style="{StaticResource SelectorButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
