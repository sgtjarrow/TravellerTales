<UserControl x:Class="TravellerTales.Views.CharacteristicsStepControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1240">
    <UserControl.Resources>
        <Style x:Key="CharacteristicHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderTextStyle}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="#C99A45" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CharacteristicNameStyle" TargetType="TextBlock" BasedOn="{StaticResource DataFieldTextStyle}">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CharacteristicCodeStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderTextStyle}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#9FEFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CharacteristicValueStyle" TargetType="TextBlock" BasedOn="{StaticResource DataFieldTextStyle}">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CharacteristicBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="LineHeight" Value="30" />
            <Setter Property="Foreground" Value="#BEDFFF" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="BaseCellStyle" TargetType="Border">
            <Setter Property="Height" Value="46" />
            <Setter Property="Background" Value="#CC0D2A3C" />
            <Setter Property="BorderBrush" Value="#5FD9FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="AllowDrop" Value="True" />
        </Style>

        <Style x:Key="ReadOnlyCellStyle" TargetType="Border">
            <Setter Property="Height" Value="46" />
            <Setter Property="Background" Value="#B006111E" />
            <Setter Property="BorderBrush" Value="#31596D" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#C806111E"
                BorderBrush="#5FD9FF"
                BorderThickness="1"
                Padding="26">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Drag or select two base values to swap them. Race adjustments are previewed here and applied when you accept this step."
                           Style="{StaticResource CharacteristicBodyTextStyle}" />

                <Border Grid.Row="2"
                        Background="#B006111E"
                        BorderBrush="#5FD9FF"
                        BorderThickness="1"
                        Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="1.25*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="CHARACTERISTIC"
                                   Style="{StaticResource CharacteristicHeaderStyle}" />
                        <TextBlock Grid.Column="1"
                                   Text="BASE"
                                   Style="{StaticResource CharacteristicHeaderStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="RACE"
                                   Style="{StaticResource CharacteristicHeaderStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="3"
                                   Text="RESULT"
                                   Style="{StaticResource CharacteristicHeaderStyle}"
                                   HorizontalAlignment="Center" />

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <TextBlock Text="Strength" Style="{StaticResource CharacteristicNameStyle}" />
                            <TextBlock Text="  STR" Style="{StaticResource CharacteristicCodeStyle}" />
                        </StackPanel>
                        <Border x:Name="StrengthBaseCell" Grid.Row="2" Grid.Column="1" Style="{StaticResource BaseCellStyle}" MouseLeftButtonDown="OnBaseCellMouseLeftButtonDown" MouseMove="OnBaseCellMouseMove" Drop="OnBaseCellDrop" DragEnter="OnBaseCellDragEnter" DragLeave="OnBaseCellDragLeave" />
                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource ReadOnlyCellStyle}">
                            <TextBlock x:Name="StrengthRaceText" Style="{StaticResource CharacteristicValueStyle}" />
                        </Border>
                        <Border Grid.Row="2" Grid.Column="3" Style="{StaticResource ReadOnlyCellStyle}">
                            <TextBlock x:Name="StrengthResultText" Style="{StaticResource CharacteristicValueStyle}" />
                        </Border>

                        <StackPanel Grid.Row="4" Orientation="Horizontal">
                            <TextBlock Text="Dexterity" Style="{StaticResource CharacteristicNameStyle}" />
                            <TextBlock Text="  DEX" Style="{StaticResource CharacteristicCodeStyle}" />
                        </StackPanel>
                        <Border x:Name="DexterityBaseCell" Grid.Row="4" Grid.Column="1" Style="{StaticResource BaseCellStyle}" MouseLeftButtonDown="OnBaseCellMouseLeftButtonDown" MouseMove="OnBaseCellMouseMove" Drop="OnBaseCellDrop" DragEnter="OnBaseCellDragEnter" DragLeave="OnBaseCellDragLeave" />
                        <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource ReadOnlyCellStyle}">
                            <TextBlock x:Name="DexterityRaceText" Style="{StaticResource CharacteristicValueStyle}" />
                        </Border>
                        <Border Grid.Row="4" Grid.Column="3" Style="{StaticResource ReadOnlyCellStyle}">
                            <TextBlock x:Name="DexterityResultText" Style="{StaticResource CharacteristicValueStyle}" />
                        </Border>

                        <StackPanel Grid.Row="6" Orientation="Horizontal">
                            <TextBlock Text="Endurance" Style="{StaticResource CharacteristicNameStyle}" />
                            <TextBlock Text="  END" Style="{StaticResource CharacteristicCodeStyle}" />
                        </StackPanel>
                        <Border x:Name="EnduranceBaseCell" Grid.Row="6" Grid.Column="1" Style="{StaticResource BaseCellStyle}" MouseLeftButtonDown="OnBaseCellMouseLeftButtonDown" MouseMove="OnBaseCellMouseMove" Drop="OnBaseCellDrop" DragEnter="OnBaseCellDragEnter" DragLeave="OnBaseCellDragLeave" />
                        <Border Grid.Row="6" Grid.Column="2" Style="{StaticResource ReadOnlyCellStyle}">
                            <TextBlock x:Name="EnduranceRaceText" Style="{StaticResource CharacteristicValueStyle}" />
                        </Border>
                        <Border Grid.Row="6" Grid.Column="3" Style="{StaticResource ReadOnlyCellStyle}">
                            <TextBlock x:Name="EnduranceResultText" Style="{StaticResource CharacteristicValueStyle}" />
                        </Border>

                        <StackPanel Grid.Row="8" Orientation="Horizontal">
                            <TextBlock Text="Intellect" Style="{StaticResource CharacteristicNameStyle}" />
                            <TextBlock Text="  INT" Style="{StaticResource CharacteristicCodeStyle}" />
                        </StackPanel>
                        <Border x:Name="IntellectBaseCell" Grid.Row="8" Grid.Column="1" Style="{StaticResource BaseCellStyle}" MouseLeftButtonDown="OnBaseCellMouseLeftButtonDown" MouseMove="OnBaseCellMouseMove" Drop="OnBaseCellDrop" DragEnter="OnBaseCellDragEnter" DragLeave="OnBaseCellDragLeave" />
                        <Border Grid.Row="8" Grid.Column="2" Style="{StaticResource ReadOnlyCellStyle}">
                            <TextBlock x:Name="IntellectRaceText" Style="{StaticResource CharacteristicValueStyle}" />
                        </Border>
                        <Border Grid.Row="8" Grid.Column="3" Style="{StaticResource ReadOnlyCellStyle}">
                            <TextBlock x:Name="IntellectResultText" Style="{StaticResource CharacteristicValueStyle}" />
                        </Border>

                        <StackPanel Grid.Row="10" Orientation="Horizontal">
                            <TextBlock Text="Education" Style="{StaticResource CharacteristicNameStyle}" />
                            <TextBlock Text="  EDU" Style="{StaticResource CharacteristicCodeStyle}" />
                        </StackPanel>
                        <Border x:Name="EducationBaseCell" Grid.Row="10" Grid.Column="1" Style="{StaticResource BaseCellStyle}" MouseLeftButtonDown="OnBaseCellMouseLeftButtonDown" MouseMove="OnBaseCellMouseMove" Drop="OnBaseCellDrop" DragEnter="OnBaseCellDragEnter" DragLeave="OnBaseCellDragLeave" />
                        <Border Grid.Row="10" Grid.Column="2" Style="{StaticResource ReadOnlyCellStyle}">
                            <TextBlock x:Name="EducationRaceText" Style="{StaticResource CharacteristicValueStyle}" />
                        </Border>
                        <Border Grid.Row="10" Grid.Column="3" Style="{StaticResource ReadOnlyCellStyle}">
                            <TextBlock x:Name="EducationResultText" Style="{StaticResource CharacteristicValueStyle}" />
                        </Border>

                        <StackPanel Grid.Row="12" Orientation="Horizontal">
                            <TextBlock Text="Social" Style="{StaticResource CharacteristicNameStyle}" />
                            <TextBlock Text="  SOC" Style="{StaticResource CharacteristicCodeStyle}" />
                        </StackPanel>
                        <Border x:Name="SocialBaseCell" Grid.Row="12" Grid.Column="1" Style="{StaticResource BaseCellStyle}" MouseLeftButtonDown="OnBaseCellMouseLeftButtonDown" MouseMove="OnBaseCellMouseMove" Drop="OnBaseCellDrop" DragEnter="OnBaseCellDragEnter" DragLeave="OnBaseCellDragLeave" />
                        <Border Grid.Row="12" Grid.Column="2" Style="{StaticResource ReadOnlyCellStyle}">
                            <TextBlock x:Name="SocialRaceText" Style="{StaticResource CharacteristicValueStyle}" />
                        </Border>
                        <Border Grid.Row="12" Grid.Column="3" Style="{StaticResource ReadOnlyCellStyle}">
                            <TextBlock x:Name="SocialResultText" Style="{StaticResource CharacteristicValueStyle}" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <TextBlock x:Name="ValidationMessage"
                   Grid.Row="1"
                   Margin="0,18,0,0"
                   Style="{StaticResource BodyTextStyle}"
                   FontSize="20"
                   Foreground="#FFB36A"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center" />
    </Grid>
</UserControl>
