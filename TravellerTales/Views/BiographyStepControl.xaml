<UserControl x:Class="TravellerTales.Views.BiographyStepControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TravellerTales.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1240">
    <UserControl.Resources>
        <Style x:Key="WizardLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderTextStyle}">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Foreground" Value="#9FEFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="WizardTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#D0071523" />
            <Setter Property="BorderBrush" Value="#5FD9FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Setter Property="CaretBrush" Value="#EAFBFF" />
            <Setter Property="FontFamily" Value="{StaticResource DataFieldFontFamily}" />
            <Setter Property="FontSize" Value="20" />
        </Style>

        <Style x:Key="WizardComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#D0071523" />
            <Setter Property="BorderBrush" Value="#5FD9FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Setter Property="FontFamily" Value="{StaticResource DataFieldFontFamily}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="38" />
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
                                                      Margin="{TemplateBinding Padding}"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center" />

                                    <ToggleButton Grid.Column="1"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="Transparent"
                                                  BorderBrush="Transparent"
                                                  BorderThickness="0"
                                                  Foreground="#DFFBFF"
                                                  FontFamily="{StaticResource LabelButtonFontFamily}"
                                                  FontSize="16"
                                                  Content="v"
                                                  Cursor="Hand" />
                                </Grid>
                            </Border>

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#F0061521"
                                        BorderBrush="#5FD9FF"
                                        BorderThickness="1">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#F0061521" />
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Setter Property="FontFamily" Value="{StaticResource DataFieldFontFamily}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="12,7" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#DD1A5574" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock" BasedOn="{StaticResource DataFieldTextStyle}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="BIOGRAPHY"
                   Style="{StaticResource AppTitleTextStyle}"
                   FontSize="42"
                   Foreground="#D8F8FF"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,18" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="0.8*" />
            </Grid.ColumnDefinitions>

            <Border Background="#C806111E"
                    BorderBrush="#5FD9FF"
                    BorderThickness="1"
                    Padding="26">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="185" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="NAME"
                               Style="{StaticResource WizardLabelStyle}" />
                    <TextBox x:Name="NameTextBox"
                             Grid.Column="1"
                             Style="{StaticResource WizardTextBoxStyle}"
                             TextChanged="OnFieldChanged" />

                    <TextBlock Grid.Row="2"
                               Text="RACE"
                               Style="{StaticResource WizardLabelStyle}" />
                    <ComboBox x:Name="RaceComboBox"
                              Grid.Row="2"
                              Grid.Column="1"
                              Style="{StaticResource WizardComboBoxStyle}"
                              SelectionChanged="OnRaceChanged" />

                    <TextBlock Grid.Row="4"
                               Text="GENDER"
                               Style="{StaticResource WizardLabelStyle}" />
                    <ComboBox x:Name="GenderComboBox"
                              Grid.Row="4"
                              Grid.Column="1"
                              Style="{StaticResource WizardComboBoxStyle}"
                              SelectionChanged="OnFieldChanged" />

                    <TextBlock Grid.Row="6"
                               Text="AGE"
                               Style="{StaticResource WizardLabelStyle}" />
                    <TextBox x:Name="AgeTextBox"
                             Grid.Row="6"
                             Grid.Column="1"
                             IsReadOnly="True"
                             Focusable="False"
                             Style="{StaticResource WizardTextBoxStyle}" />

                    <TextBlock Grid.Row="8"
                               Text="HEIGHT (INCHES)"
                               Style="{StaticResource WizardLabelStyle}" />
                    <Grid Grid.Row="8"
                          Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:NumericStepper x:Name="HeightStepper"
                                                  Minimum="1"
                                                  ValueChanged="OnFieldChanged" />
                        <TextBlock Grid.Column="2"
                                   Text="METERS"
                                   Style="{StaticResource WizardLabelStyle}" />
                        <TextBlock x:Name="HeightMetersText"
                                   Grid.Column="3"
                                   Style="{StaticResource MetricValueStyle}" />
                    </Grid>

                    <TextBlock Grid.Row="10"
                               Text="WEIGHT (POUNDS)"
                               Style="{StaticResource WizardLabelStyle}" />
                    <Grid Grid.Row="10"
                          Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:NumericStepper x:Name="WeightStepper"
                                                  Minimum="1"
                                                  ValueChanged="OnFieldChanged" />
                        <TextBlock Grid.Column="2"
                                   Text="KILOGRAMS"
                                   Style="{StaticResource WizardLabelStyle}" />
                        <TextBlock x:Name="WeightKilogramsText"
                                   Grid.Column="3"
                                   Style="{StaticResource MetricValueStyle}" />
                    </Grid>

                    <TextBlock Grid.Row="12"
                               Text="EYE COLOR"
                               Style="{StaticResource WizardLabelStyle}" />
                    <TextBox x:Name="EyeColorTextBox"
                             Grid.Row="12"
                             Grid.Column="1"
                             Style="{StaticResource WizardTextBoxStyle}"
                             TextChanged="OnFieldChanged" />

                    <TextBlock Grid.Row="14"
                               Text="DESCRIPTION"
                               Style="{StaticResource WizardLabelStyle}"
                               VerticalAlignment="Top"
                               Margin="0,8,0,0" />
                    <TextBox x:Name="DescriptionTextBox"
                             Grid.Row="14"
                             Grid.Column="1"
                             Height="104"
                             MinHeight="104"
                             Padding="12"
                             VerticalContentAlignment="Top"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Style="{StaticResource WizardTextBoxStyle}"
                             TextChanged="OnFieldChanged" />

                    <TextBlock Grid.Row="16"
                               Text="NOTES"
                               Style="{StaticResource WizardLabelStyle}"
                               VerticalAlignment="Top"
                               Margin="0,8,0,0" />
                    <TextBox x:Name="NotesTextBox"
                             Grid.Row="16"
                             Grid.Column="1"
                             Height="104"
                             MinHeight="104"
                             Padding="12"
                             VerticalContentAlignment="Top"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Style="{StaticResource WizardTextBoxStyle}"
                             TextChanged="OnFieldChanged" />
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Border x:Name="HumanDetailsCard"
                        Background="#D006111E"
                        BorderBrush="#C99A45"
                        BorderThickness="1"
                        Padding="28">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="165" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.ColumnSpan="2"
                                   Text="HUMAN PROFILE"
                                   Style="{StaticResource AppTitleTextStyle}"
                                   FontSize="30"
                                   Foreground="#D8F8FF"
                                   HorizontalAlignment="Center" />

                        <TextBlock Grid.Row="2"
                                   Text="HERITAGE"
                                   Style="{StaticResource WizardLabelStyle}" />
                        <ComboBox x:Name="HeritageComboBox"
                                  Grid.Row="2"
                                  Grid.Column="1"
                                  Style="{StaticResource WizardComboBoxStyle}"
                                  SelectionChanged="OnFieldChanged" />

                        <TextBlock Grid.Row="4"
                                   Text="HAIR COLOR"
                                   Style="{StaticResource WizardLabelStyle}" />
                        <TextBox x:Name="HairColorTextBox"
                                 Grid.Row="4"
                                 Grid.Column="1"
                                 Style="{StaticResource WizardTextBoxStyle}"
                                 TextChanged="OnFieldChanged" />
                    </Grid>
                </Border>

                <Border x:Name="NonHumanDetailsCard"
                        Visibility="Collapsed"
                        Background="#D006111E"
                        BorderBrush="#C99A45"
                        BorderThickness="1"
                        Padding="28">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="175" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.ColumnSpan="2"
                                   Text="NON-HUMAN PROFILE"
                                   Style="{StaticResource AppTitleTextStyle}"
                                   FontSize="30"
                                   Foreground="#D8F8FF"
                                   HorizontalAlignment="Center" />

                        <TextBlock Grid.Row="2"
                                   Text="FUR PATTERN"
                                   Style="{StaticResource WizardLabelStyle}" />
                        <TextBox x:Name="FurPatternTextBox"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 Style="{StaticResource WizardTextBoxStyle}"
                                 TextChanged="OnFieldChanged" />

                        <TextBlock Grid.Row="4"
                                   Text="FUR PRIMARY"
                                   Style="{StaticResource WizardLabelStyle}" />
                        <TextBox x:Name="FurPrimaryColorTextBox"
                                 Grid.Row="4"
                                 Grid.Column="1"
                                 Style="{StaticResource WizardTextBoxStyle}"
                                 TextChanged="OnFieldChanged" />

                        <TextBlock Grid.Row="6"
                                   Text="FUR SECONDARY"
                                   Style="{StaticResource WizardLabelStyle}" />
                        <TextBox x:Name="FurSecondaryColorTextBox"
                                 Grid.Row="6"
                                 Grid.Column="1"
                                 Style="{StaticResource WizardTextBoxStyle}"
                                 TextChanged="OnFieldChanged" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <TextBlock x:Name="ValidationMessage"
                   Grid.Row="2"
                   Margin="0,18,0,0"
                   Style="{StaticResource BodyTextStyle}"
                   FontSize="20"
                   Foreground="#FFB36A"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center" />
    </Grid>
</UserControl>
