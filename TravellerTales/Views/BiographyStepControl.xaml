<UserControl x:Class="TravellerTales.Views.BiographyStepControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TravellerTales.Controls"
             xmlns:views="clr-namespace:TravellerTales.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1240">
    <UserControl.Resources>
        <views:EnumDisplayConverter x:Key="EnumDisplayConverter" />

        <Style x:Key="WizardLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderTextStyle}">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Foreground" Value="#9FEFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="NamePartLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderTextStyle}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#9FEFFF" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="WizardTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#D0071523" />
            <Setter Property="BorderBrush" Value="#5FD9FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Setter Property="CaretBrush" Value="#EAFBFF" />
            <Setter Property="FontFamily" Value="{StaticResource DataFieldFontFamily}" />
            <Setter Property="FontSize" Value="20" />
        </Style>

        <Style x:Key="WizardComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#D0071523" />
            <Setter Property="BorderBrush" Value="#5FD9FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource DataFieldFontFamily}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="38" />
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
                                                      Margin="{TemplateBinding Padding}"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center" />

                                    <ToggleButton x:Name="DropdownToggle"
                                                  Grid.Column="1"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="Transparent"
                                                  BorderBrush="Transparent"
                                                  BorderThickness="0"
                                                  Foreground="#DFFBFF"
                                                  FontFamily="{StaticResource LabelButtonFontFamily}"
                                                  FontSize="16"
                                                  Content="v"
                                                  Cursor="Hand">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#F0061521"
                                        BorderBrush="#5FD9FF"
                                        BorderThickness="1">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder" Property="Background" Value="#B0061521" />
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#3D8EAA" />
                                <Setter TargetName="DropdownToggle" Property="Foreground" Value="#6FB9CA" />
                                <Setter TargetName="DropdownToggle" Property="Background" Value="#400D3144" />
                                <Setter Property="Foreground" Value="#BFEAF2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#F0061521" />
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Setter Property="FontFamily" Value="{StaticResource DataFieldFontFamily}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="12,7" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#DD1A5574" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock" BasedOn="{StaticResource DataFieldTextStyle}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RandomNameButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="#D0071523" />
            <Setter Property="BorderBrush" Value="#5FD9FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Setter Property="FontFamily" Value="{StaticResource LabelButtonFontFamily}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,0,0,-74">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="0.8*" />
            </Grid.ColumnDefinitions>

            <Border Background="#C806111E"
                    BorderBrush="#5FD9FF"
                    BorderThickness="1"
                    Padding="26">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="0,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="185" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="NAME"
                               Style="{StaticResource WizardLabelStyle}" />
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="42" />
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="HumanNamePanel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="0.7*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="FIRST"
                                       Style="{StaticResource NamePartLabelStyle}" />
                            <TextBlock Grid.Column="2"
                                       Text="MIDDLE"
                                       Style="{StaticResource NamePartLabelStyle}" />
                            <TextBlock Grid.Column="4"
                                       Text="LAST"
                                       Style="{StaticResource NamePartLabelStyle}" />
                            <TextBlock Grid.Column="6"
                                       Text="SUFFIX"
                                       Style="{StaticResource NamePartLabelStyle}" />
                            <TextBox x:Name="HumanFirstNameTextBox"
                                     Grid.Row="1"
                                     Style="{StaticResource WizardTextBoxStyle}"
                                     ToolTip="First Name"
                                     TextChanged="OnFieldChanged" />
                            <TextBox x:Name="HumanMiddleNameTextBox"
                                     Grid.Row="1"
                                     Grid.Column="2"
                                     Style="{StaticResource WizardTextBoxStyle}"
                                     ToolTip="Middle Name"
                                     TextChanged="OnFieldChanged" />
                            <TextBox x:Name="HumanLastNameTextBox"
                                     Grid.Row="1"
                                     Grid.Column="4"
                                     Style="{StaticResource WizardTextBoxStyle}"
                                     ToolTip="Last Name"
                                     TextChanged="OnFieldChanged" />
                            <TextBox x:Name="HumanSuffixTextBox"
                                     Grid.Row="1"
                                     Grid.Column="6"
                                     Style="{StaticResource WizardTextBoxStyle}"
                                     ToolTip="Suffix"
                                     TextChanged="OnFieldChanged" />
                        </Grid>

                        <Grid x:Name="AslanNamePanel"
                              Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="FAMILY"
                                       Style="{StaticResource NamePartLabelStyle}" />
                            <TextBlock Grid.Column="2"
                                       Text="PERSONAL"
                                       Style="{StaticResource NamePartLabelStyle}" />
                            <TextBox x:Name="AslanFamilyNameTextBox"
                                     Grid.Row="1"
                                     Style="{StaticResource WizardTextBoxStyle}"
                                     ToolTip="Family Name"
                                     TextChanged="OnFieldChanged" />
                            <TextBox x:Name="AslanPersonalNameTextBox"
                                     Grid.Row="1"
                                     Grid.Column="2"
                                     Style="{StaticResource WizardTextBoxStyle}"
                                     ToolTip="Personal Name"
                                     TextChanged="OnFieldChanged" />
                        </Grid>

                        <Grid x:Name="VargrNamePanel"
                              Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CLAN"
                                       Style="{StaticResource NamePartLabelStyle}" />
                            <TextBlock Grid.Column="2"
                                       Text="ROLE"
                                       Style="{StaticResource NamePartLabelStyle}" />
                            <TextBlock Grid.Column="4"
                                       Text="PERSONAL"
                                       Style="{StaticResource NamePartLabelStyle}" />
                            <TextBox x:Name="VargrClanNameTextBox"
                                     Grid.Row="1"
                                     Style="{StaticResource WizardTextBoxStyle}"
                                     ToolTip="Clan Name"
                                     TextChanged="OnFieldChanged" />
                            <ComboBox x:Name="VargrRoleComboBox"
                                      Grid.Row="1"
                                      Grid.Column="2"
                                      Style="{StaticResource WizardComboBoxStyle}"
                                      ToolTip="Clan Role"
                                      SelectionChanged="OnFieldChanged" />
                            <TextBox x:Name="VargrPersonalNameTextBox"
                                     Grid.Row="1"
                                     Grid.Column="4"
                                     Style="{StaticResource WizardTextBoxStyle}"
                                     ToolTip="Personal Name"
                                     TextChanged="OnFieldChanged" />
                        </Grid>

                        <Button Grid.Column="2"
                                Content="?"
                                Style="{StaticResource RandomNameButtonStyle}"
                                VerticalAlignment="Bottom"
                                ToolTip="Generate Random Name"
                                Click="OnGenerateName" />
                    </Grid>

                    <TextBlock Grid.Row="2"
                               Text="RACE"
                               Style="{StaticResource WizardLabelStyle}" />
                    <ComboBox x:Name="RaceComboBox"
                              Grid.Row="2"
                              Grid.Column="1"
                              Style="{StaticResource WizardComboBoxStyle}"
                              SelectionChanged="OnRaceChanged" />

                    <TextBlock Grid.Row="4"
                               Text="GENDER"
                               Style="{StaticResource WizardLabelStyle}" />
                    <ComboBox x:Name="GenderComboBox"
                              Grid.Row="4"
                              Grid.Column="1"
                              Style="{StaticResource WizardComboBoxStyle}"
                              SelectionChanged="OnGenderChanged" />

                    <TextBlock Grid.Row="6"
                               Text="AGE"
                               Style="{StaticResource WizardLabelStyle}" />
                    <TextBox x:Name="AgeTextBox"
                             Grid.Row="6"
                             Grid.Column="1"
                             IsReadOnly="True"
                             Focusable="False"
                             Style="{StaticResource WizardTextBoxStyle}" />

                    <TextBlock Grid.Row="8"
                               Text="HEIGHT"
                               Style="{StaticResource WizardLabelStyle}" />
                    <Grid Grid.Row="8"
                          Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="95" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="INCHES"
                                   Style="{StaticResource WizardLabelStyle}" />
                        <Border x:Name="HeightStepperBorder"
                                Grid.Column="2"
                                BorderBrush="#5FD9FF"
                                BorderThickness="2">
                            <controls:NumericStepper x:Name="HeightStepper"
                                                      Minimum="1"
                                                      ValueChanged="OnFieldChanged" />
                        </Border>
                        <TextBlock Grid.Column="4"
                                   Text="METERS"
                                   Style="{StaticResource WizardLabelStyle}" />
                        <TextBlock x:Name="HeightMetersText"
                                   Grid.Column="5"
                                   Style="{StaticResource MetricValueStyle}" />
                    </Grid>

                    <TextBlock Grid.Row="10"
                               Text="WEIGHT"
                               Style="{StaticResource WizardLabelStyle}" />
                    <Grid Grid.Row="10"
                          Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="95" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="POUNDS"
                                   Style="{StaticResource WizardLabelStyle}" />
                        <Border x:Name="WeightStepperBorder"
                                Grid.Column="2"
                                BorderBrush="#5FD9FF"
                                BorderThickness="2">
                            <controls:NumericStepper x:Name="WeightStepper"
                                                      Minimum="1"
                                                      ValueChanged="OnFieldChanged" />
                        </Border>
                        <TextBlock Grid.Column="4"
                                   Text="KILOGRAMS"
                                   Style="{StaticResource WizardLabelStyle}" />
                        <TextBlock x:Name="WeightKilogramsText"
                                   Grid.Column="5"
                                   Style="{StaticResource MetricValueStyle}" />
                    </Grid>

                    <TextBlock Grid.Row="12"
                               Text="EYE COLOR"
                               Style="{StaticResource WizardLabelStyle}" />
                    <ComboBox x:Name="EyeColorComboBox"
                              Grid.Row="12"
                              Grid.Column="1"
                              Style="{StaticResource WizardComboBoxStyle}"
                              SelectionChanged="OnFieldChanged" />

                    <TextBlock Grid.Row="14"
                               Text="DESCRIPTION"
                               Style="{StaticResource WizardLabelStyle}"
                               VerticalAlignment="Top"
                               Margin="0,8,0,0" />
                    <TextBox x:Name="DescriptionTextBox"
                             Grid.Row="14"
                             Grid.Column="1"
                             Height="104"
                             MinHeight="104"
                             Padding="12"
                             VerticalContentAlignment="Top"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Style="{StaticResource WizardTextBoxStyle}"
                             TextChanged="OnFieldChanged" />

                    <TextBlock Grid.Row="16"
                               Text="NOTES"
                               Style="{StaticResource WizardLabelStyle}"
                               VerticalAlignment="Top"
                               Margin="0,8,0,0" />
                    <TextBox x:Name="NotesTextBox"
                             Grid.Row="16"
                             Grid.Column="1"
                             Height="104"
                             MinHeight="104"
                             Padding="12"
                             VerticalContentAlignment="Top"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Style="{StaticResource WizardTextBoxStyle}"
                             TextChanged="OnFieldChanged" />
                </Grid>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="2"
                  Margin="0,0,0,74">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="HumanDetailsCard"
                        Background="#D006111E"
                        BorderBrush="#5FD9FF"
                        BorderThickness="1"
                        Padding="22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="165" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.ColumnSpan="2"
                                   Text="HUMAN PROFILE"
                                   Style="{StaticResource AppTitleTextStyle}"
                                   FontSize="30"
                                   Foreground="#D8F8FF"
                                   HorizontalAlignment="Center" />

                        <TextBlock Grid.Row="2"
                                   Text="SKIN COLOR"
                                   Style="{StaticResource WizardLabelStyle}" />
                        <ComboBox x:Name="SkinColorComboBox"
                                  Grid.Row="2"
                                  Grid.Column="1"
                                  Style="{StaticResource WizardComboBoxStyle}"
                                  SelectionChanged="OnSkinColorChanged" />

                        <TextBlock Grid.Row="4"
                                   Text="HERITAGE"
                                   Style="{StaticResource WizardLabelStyle}" />
                        <ComboBox x:Name="HeritageComboBox"
                                  Grid.Row="4"
                                  Grid.Column="1"
                                  Style="{StaticResource WizardComboBoxStyle}"
                                  SelectionChanged="OnFieldChanged" />

                        <TextBlock Grid.Row="6"
                                   Text="HAIR COLOR"
                                   Style="{StaticResource WizardLabelStyle}" />
                        <ComboBox x:Name="HairColorComboBox"
                                  Grid.Row="6"
                                  Grid.Column="1"
                                  Style="{StaticResource WizardComboBoxStyle}"
                                  SelectionChanged="OnFieldChanged" />
                    </Grid>
                </Border>

                <Border x:Name="NonHumanDetailsCard"
                        Grid.Row="0"
                        Visibility="Collapsed"
                        Background="#D006111E"
                        BorderBrush="#5FD9FF"
                        BorderThickness="1"
                        Padding="22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="175" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.ColumnSpan="2"
                                   Text="NON-HUMAN PROFILE"
                                   Style="{StaticResource AppTitleTextStyle}"
                                   FontSize="30"
                                   Foreground="#D8F8FF"
                                   HorizontalAlignment="Center" />

                        <TextBlock Grid.Row="2"
                                   Text="FUR PATTERN"
                                   Style="{StaticResource WizardLabelStyle}" />
                        <ComboBox x:Name="FurPatternComboBox"
                                  Grid.Row="2"
                                  Grid.Column="1"
                                  Style="{StaticResource WizardComboBoxStyle}"
                                  SelectionChanged="OnFurPatternChanged" />

                        <TextBlock Grid.Row="4"
                                   Text="FUR PRIMARY"
                                   Style="{StaticResource WizardLabelStyle}" />
                        <ComboBox x:Name="FurPrimaryColorComboBox"
                                  Grid.Row="4"
                                  Grid.Column="1"
                                  Style="{StaticResource WizardComboBoxStyle}"
                                  SelectionChanged="OnFieldChanged" />

                        <TextBlock Grid.Row="6"
                                   Text="FUR SECONDARY"
                                   Style="{StaticResource WizardLabelStyle}" />
                        <ComboBox x:Name="FurSecondaryColorComboBox"
                                  Grid.Row="6"
                                  Grid.Column="1"
                                  Style="{StaticResource WizardComboBoxStyle}"
                                  SelectionChanged="OnFieldChanged" />
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Background="#D006111E"
                        BorderBrush="#5FD9FF"
                        BorderThickness="1">
                    <Image x:Name="CharacterPortraitImage"
                           Stretch="Uniform" />
                </Border>
            </Grid>
        </Grid>

        <TextBlock x:Name="ValidationMessage"
                   Grid.Row="1"
                   Margin="0,18,0,0"
                   Style="{StaticResource BodyTextStyle}"
                   FontSize="20"
                   Foreground="#FFB36A"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center" />
    </Grid>
</UserControl>
