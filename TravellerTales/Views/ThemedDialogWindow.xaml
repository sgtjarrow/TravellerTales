<Window x:Class="TravellerTales.Views.ThemedDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Traveller Tales"
        Width="640"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource AppForegroundBrush}"
        FontFamily="{StaticResource BodyTextFontFamily}"
        KeyDown="OnKeyDown">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="126" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="22,8" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="Background" Value="#CC061521" />
            <Setter Property="BorderBrush" Value="#8CE8FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Setter Property="FontFamily" Value="{StaticResource LabelButtonFontFamily}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DD0D2A3C" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#C9F5FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EE174A64" />
                            </Trigger>
                            <Trigger Property="IsDefault" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#C99A45" />
                            </Trigger>
                            <Trigger Property="IsCancel" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FFB36A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogCloseButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="18,0,0,0" />
            <Setter Property="Background" Value="#CC2A0610" />
            <Setter Property="BorderBrush" Value="#FF6B6B" />
            <Setter Property="Foreground" Value="#FF9A9A" />
            <Setter Property="FontFamily" Value="{StaticResource LabelButtonFontFamily}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DD4A0A14" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF9A9A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EE6B101C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#6600040A"
            Padding="12">
        <Border Background="#F0061521"
                BorderBrush="#8CE8FF"
                BorderThickness="2"
                Padding="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="IconFrame"
                            Width="42"
                            Height="42"
                            BorderThickness="1"
                            BorderBrush="#FFB36A"
                            Background="#33000000">
                        <TextBlock x:Name="IconText"
                                   Text="!"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource AppTitleFontFamily}"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="#FFB36A" />
                    </Border>

                    <TextBlock x:Name="TitleText"
                               Grid.Column="2"
                               Style="{StaticResource SectionHeaderTextStyle}"
                               FontSize="31"
                               Foreground="#D8F8FF"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="3"
                            Content="X"
                            Click="OnClose"
                            AutomationProperties.Name="Close Dialog"
                            Style="{StaticResource DialogCloseButtonStyle}" />
                </Grid>

                <Rectangle Grid.Row="1"
                           Height="1"
                           Margin="0,17,0,0"
                           Fill="#447EDBFF" />

                <TextBlock x:Name="MessageText"
                           Grid.Row="2"
                           Style="{StaticResource BodyTextStyle}"
                           FontSize="21"
                           LineHeight="30"
                           Foreground="#EAFBFF"
                           TextWrapping="Wrap" />

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="YesButton"
                            Content="Yes"
                            Click="OnYes"
                            AutomationProperties.Name="Yes"
                            Style="{StaticResource DialogButtonStyle}" />
                    <Button x:Name="NoButton"
                            Content="No"
                            Click="OnNo"
                            AutomationProperties.Name="No"
                            Style="{StaticResource DialogButtonStyle}" />
                    <Button x:Name="OkButton"
                            Content="OK"
                            Click="OnOk"
                            AutomationProperties.Name="OK"
                            Style="{StaticResource DialogButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
