<UserControl x:Class="TravellerTales.Views.NewCharacterWizardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TravellerTales.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="941"
             d:DesignWidth="1672">
    <UserControl.Resources>
        <Style x:Key="WizardButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="154" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="22,8" />
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="Background" Value="#CC061521" />
            <Setter Property="BorderBrush" Value="#8CE8FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Setter Property="FontFamily" Value="{StaticResource LabelButtonFontFamily}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DD0D2A3C" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#C9F5FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EE174A64" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#CCB32626" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#7A1E1E" />
                                <Setter Property="Foreground" Value="#080A0E" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderTextStyle}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="ReviewTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#5FD9FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="ReviewTabItemStyle" TargetType="TabItem">
            <Setter Property="Background" Value="#99071523" />
            <Setter Property="BorderBrush" Value="#5FD9FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#BEDFFF" />
            <Setter Property="FontFamily" Value="{StaticResource SectionHeaderFontFamily}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Padding" Value="24,9" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabHeaderBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Margin="{TemplateBinding Margin}">
                            <ContentPresenter ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabHeaderBorder" Property="Background" Value="#DD0D2A3C" />
                                <Setter TargetName="TabHeaderBorder" Property="BorderBrush" Value="#C9F5FF" />
                                <Setter Property="Foreground" Value="#EAFBFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabHeaderBorder" Property="Background" Value="#CC12344A" />
                                <Setter TargetName="TabHeaderBorder" Property="BorderBrush" Value="#C9F5FF" />
                                <Setter Property="Foreground" Value="#EAFBFF" />
                                <Setter Property="Panel.ZIndex" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="UniformToFill"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
        <Grid Width="1672"
              Height="941"
              Background="#05080F">
            <Image x:Name="WizardBackgroundImage"
                   Source="pack://application:,,,/Assets/medical_scan.png"
                   Stretch="Fill"
                   Opacity="0.88" />

            <Border Margin="84,48,84,58"
                    Background="#D9050A12"
                    BorderBrush="#66D9FF"
                    BorderThickness="2">
                <Grid Margin="34">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="NEW CHARACTER"
                                   Style="{StaticResource AppTitleTextStyle}"
                                   FontSize="35"
                                   Foreground="#D8F8FF"
                                   VerticalAlignment="Center" />

                        <TextBlock x:Name="WizardStatusText"
                                   Grid.Column="1"
                                   Style="{StaticResource DataFieldTextStyle}"
                                   FontSize="20"
                                   Foreground="#9FEFFF"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <UniformGrid Grid.Row="2"
                                 Columns="5">
                        <Border x:Name="BiographyStepIndicator"
                                Height="62"
                                Margin="5,0"
                                BorderThickness="1">
                            <TextBlock Text="BIOGRAPHY"
                                       Style="{StaticResource StepTitleStyle}" />
                        </Border>
                        <Border x:Name="HomeworldStepIndicator"
                                Height="62"
                                Margin="5,0"
                                BorderThickness="1">
                            <TextBlock Text="HOMEWORLD"
                                       Style="{StaticResource StepTitleStyle}" />
                        </Border>
                        <Border x:Name="CharacteristicsStepIndicator"
                                Height="62"
                                Margin="5,0"
                                BorderThickness="1">
                            <TextBlock Text="CHARACTERISTICS"
                                       Style="{StaticResource StepTitleStyle}" />
                        </Border>
                        <Border x:Name="BackgroundSkillsStepIndicator"
                                Height="62"
                                Margin="5,0"
                                BorderThickness="1">
                            <TextBlock Text="BACKGROUND SKILLS"
                                       Style="{StaticResource StepTitleStyle}" />
                        </Border>
                        <Border x:Name="ReviewStepIndicator"
                                Height="62"
                                Margin="5,0"
                                BorderThickness="1">
                            <TextBlock Text="REVIEW"
                                       Style="{StaticResource StepTitleStyle}" />
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="4">
                        <views:BiographyStepControl x:Name="BiographyStep"
                                                    Visibility="Visible" />

                        <views:HomeworldStepControl x:Name="HomeworldStep"
                                                    Visibility="Collapsed" />

                        <views:CharacteristicsStepControl x:Name="CharacteristicsStep"
                                                          Visibility="Collapsed" />

                        <views:BackgroundSkillsStepControl x:Name="BackgroundSkillsStep"
                                                           Visibility="Collapsed" />

                        <Border x:Name="ReviewPlaceholder"
                                Visibility="Collapsed"
                                Background="#C006111E"
                                BorderBrush="#5FD9FF"
                                BorderThickness="1"
                                Padding="42">
                            <Grid>
                                <TabControl x:Name="ReviewTabControl"
                                            Margin="0"
                                            Style="{StaticResource ReviewTabControlStyle}"
                                            ItemContainerStyle="{StaticResource ReviewTabItemStyle}">
                                    <TabItem Header="CHARACTER">
                                        <ScrollViewer x:Name="ReviewCharacterScrollViewer"
                                                      Padding="26"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel>
                                                <TextBlock Text="CHARACTER SHEET PREVIEW"
                                                           Style="{StaticResource SectionHeaderTextStyle}"
                                                           FontSize="28"
                                                           Foreground="#9FEFFF"
                                                           Margin="0,0,0,20" />
                                                <TextBlock x:Name="ReviewIdentityText"
                                                           Style="{StaticResource DataFieldTextStyle}"
                                                           FontSize="24"
                                                           Foreground="#EAFBFF"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>

                                    <TabItem Header="LOG">
                                        <ScrollViewer x:Name="ReviewLogScrollViewer"
                                                      Padding="26"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel>
                                                <TextBlock Text="CREATION LOG"
                                                           Style="{StaticResource SectionHeaderTextStyle}"
                                                           FontSize="28"
                                                           Foreground="#9FEFFF"
                                                           Margin="0,0,0,20" />
                                                <TextBlock x:Name="ReviewMetadataText"
                                                           Style="{StaticResource DataFieldTextStyle}"
                                                           FontSize="21"
                                                           LineHeight="30"
                                                           Foreground="#EAFBFF"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="6">
                        <TextBlock x:Name="FooterMessageText"
                                   Style="{StaticResource BodyTextStyle}"
                                   FontSize="18"
                                   Foreground="#FFB36A"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="Save"
                                    Click="OnSave"
                                    AutomationProperties.Name="Save Character Creation"
                                    Style="{StaticResource WizardButtonStyle}" />
                            <Button Content="Cancel"
                                    Click="OnCancel"
                                    AutomationProperties.Name="Cancel Character Creation"
                                    Style="{StaticResource WizardButtonStyle}" />
                            <Button x:Name="NextButton"
                                    Content="Next"
                                    Click="OnNext"
                                    AutomationProperties.Name="Next Character Creation Step"
                                    Style="{StaticResource WizardButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Viewbox>
</UserControl>
