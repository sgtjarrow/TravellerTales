<UserControl x:Class="TravellerTales.Views.NewCharacterWizardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TravellerTales.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="941"
             d:DesignWidth="1672">
    <UserControl.Resources>
        <Style x:Key="WizardButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="154" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="22,8" />
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="Background" Value="#CC061521" />
            <Setter Property="BorderBrush" Value="#8CE8FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Setter Property="FontFamily" Value="{StaticResource LabelButtonFontFamily}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DD0D2A3C" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#C9F5FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EE174A64" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#CCB32626" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#7A1E1E" />
                                <Setter Property="Foreground" Value="#080A0E" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderTextStyle}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="UniformToFill"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
        <Grid Width="1672"
              Height="941"
              Background="#05080F">
            <Image Source="pack://application:,,,/Assets/medical_scan.png"
                   Stretch="Fill"
                   Opacity="0.88" />

            <Border Margin="84,48,84,58"
                    Background="#D9050A12"
                    BorderBrush="#66D9FF"
                    BorderThickness="2">
                <Grid Margin="34">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="NEW CHARACTER"
                                   Style="{StaticResource AppTitleTextStyle}"
                                   FontSize="35"
                                   Foreground="#D8F8FF"
                                   VerticalAlignment="Center" />

                        <TextBlock x:Name="WizardStatusText"
                                   Grid.Column="1"
                                   Style="{StaticResource DataFieldTextStyle}"
                                   FontSize="20"
                                   Foreground="#9FEFFF"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <UniformGrid Grid.Row="2"
                                 Columns="5">
                        <Border x:Name="BiographyStepIndicator"
                                Height="62"
                                Margin="5,0"
                                BorderThickness="1">
                            <TextBlock Text="BIOGRAPHY"
                                       Style="{StaticResource StepTitleStyle}" />
                        </Border>
                        <Border x:Name="HomeworldStepIndicator"
                                Height="62"
                                Margin="5,0"
                                BorderThickness="1">
                            <TextBlock Text="HOMEWORLD"
                                       Style="{StaticResource StepTitleStyle}" />
                        </Border>
                        <Border x:Name="CharacteristicsStepIndicator"
                                Height="62"
                                Margin="5,0"
                                BorderThickness="1">
                            <TextBlock Text="CHARACTERISTICS"
                                       Style="{StaticResource StepTitleStyle}" />
                        </Border>
                        <Border x:Name="BackgroundSkillsStepIndicator"
                                Height="62"
                                Margin="5,0"
                                BorderThickness="1">
                            <TextBlock Text="BACKGROUND SKILLS"
                                       Style="{StaticResource StepTitleStyle}" />
                        </Border>
                        <Border x:Name="ReviewStepIndicator"
                                Height="62"
                                Margin="5,0"
                                BorderThickness="1">
                            <TextBlock Text="REVIEW"
                                       Style="{StaticResource StepTitleStyle}" />
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="4">
                        <views:BiographyStepControl x:Name="BiographyStep"
                                                    Visibility="Visible" />

                        <Border x:Name="HomeworldPlaceholder"
                                Visibility="Collapsed"
                                Background="#C006111E"
                                BorderBrush="#5FD9FF"
                                BorderThickness="1"
                                Padding="42">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="HOMEWORLD"
                                           Style="{StaticResource AppTitleTextStyle}"
                                           FontSize="46"
                                           Foreground="#D8F8FF"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="This step will define birthplace, trade codes, education opportunities, and homeworld modifiers in a later slice."
                                           Style="{StaticResource BodyTextStyle}"
                                           FontSize="24"
                                           LineHeight="34"
                                           Foreground="#BEDFFF"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Width="920"
                                           Margin="0,24,0,0" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="BackgroundSkillsPlaceholder"
                                Visibility="Collapsed"
                                Background="#C006111E"
                                BorderBrush="#5FD9FF"
                                BorderThickness="1"
                                Padding="42">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="BACKGROUND SKILLS"
                                           Style="{StaticResource AppTitleTextStyle}"
                                           FontSize="46"
                                           Foreground="#D8F8FF"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="This step will assign early life and background skill choices in a later slice."
                                           Style="{StaticResource BodyTextStyle}"
                                           FontSize="24"
                                           LineHeight="34"
                                           Foreground="#BEDFFF"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Width="920"
                                           Margin="0,24,0,0" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="CharacteristicsPlaceholder"
                                Visibility="Collapsed"
                                Background="#C006111E"
                                BorderBrush="#5FD9FF"
                                BorderThickness="1"
                                Padding="42">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="CHARACTERISTICS"
                                           Style="{StaticResource AppTitleTextStyle}"
                                           FontSize="46"
                                           Foreground="#D8F8FF"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="This step will define core characteristics in a later slice."
                                           Style="{StaticResource BodyTextStyle}"
                                           FontSize="24"
                                           LineHeight="34"
                                           Foreground="#BEDFFF"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Width="920"
                                           Margin="0,24,0,0" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="ReviewPlaceholder"
                                Visibility="Collapsed"
                                Background="#C006111E"
                                BorderBrush="#5FD9FF"
                                BorderThickness="1"
                                Padding="42">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="REVIEW"
                                           Style="{StaticResource AppTitleTextStyle}"
                                           FontSize="46"
                                           Foreground="#D8F8FF"
                                           HorizontalAlignment="Center" />

                                <Grid Grid.Row="1"
                                      Margin="0,34,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="CHARACTER SHEET PREVIEW"
                                                   Style="{StaticResource SectionHeaderTextStyle}"
                                                   FontSize="28"
                                                   Foreground="#9FEFFF"
                                                   Margin="0,0,0,20" />
                                        <TextBlock x:Name="ReviewIdentityText"
                                                   Style="{StaticResource DataFieldTextStyle}"
                                                   FontSize="24"
                                                   Foreground="#EAFBFF"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="CREATION LOG"
                                                   Style="{StaticResource SectionHeaderTextStyle}"
                                                   FontSize="28"
                                                   Foreground="#9FEFFF"
                                                   Margin="0,0,0,20" />
                                        <TextBlock x:Name="ReviewMetadataText"
                                                   Style="{StaticResource DataFieldTextStyle}"
                                                   FontSize="21"
                                                   LineHeight="30"
                                                   Foreground="#EAFBFF"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="6">
                        <TextBlock x:Name="FooterMessageText"
                                   Style="{StaticResource BodyTextStyle}"
                                   FontSize="18"
                                   Foreground="#FFB36A"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="Save"
                                    Click="OnSave"
                                    AutomationProperties.Name="Save Character Creation"
                                    Style="{StaticResource WizardButtonStyle}" />
                            <Button Content="Cancel"
                                    Click="OnCancel"
                                    AutomationProperties.Name="Cancel Character Creation"
                                    Style="{StaticResource WizardButtonStyle}" />
                            <Button x:Name="NextButton"
                                    Content="Next"
                                    Click="OnNext"
                                    AutomationProperties.Name="Next Character Creation Step"
                                    Style="{StaticResource WizardButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Viewbox>
</UserControl>
