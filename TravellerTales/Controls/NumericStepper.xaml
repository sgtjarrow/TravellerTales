<UserControl x:Class="TravellerTales.Controls.NumericStepper"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="42"
             d:DesignWidth="150">
    <Grid Width="150"
          Height="42">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="38" />
            <ColumnDefinition Width="74" />
            <ColumnDefinition Width="38" />
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0"
                Content="-"
                Click="OnDecrease"
                Background="#D0071523"
                BorderBrush="#5FD9FF"
                BorderThickness="1"
                Foreground="#EAFBFF"
                FontFamily="{StaticResource LabelButtonFontFamily}"
                FontSize="21"
                Cursor="Hand" />

        <TextBox x:Name="ValueTextBox"
                 Grid.Column="1"
                 Margin="-1,0"
                 Padding="6,0"
                 VerticalContentAlignment="Center"
                 HorizontalContentAlignment="Center"
                 TextAlignment="Center"
                 Background="#D0071523"
                 BorderBrush="#5FD9FF"
                 BorderThickness="1"
                 Foreground="#EAFBFF"
                 CaretBrush="#EAFBFF"
                 FontFamily="{StaticResource DataFieldFontFamily}"
                 FontSize="20"
                 PreviewTextInput="OnPreviewTextInput"
                 TextChanged="OnTextChanged" />

        <Button Grid.Column="2"
                Content="+"
                Click="OnIncrease"
                Background="#D0071523"
                BorderBrush="#5FD9FF"
                BorderThickness="1"
                Foreground="#EAFBFF"
                FontFamily="{StaticResource LabelButtonFontFamily}"
                FontSize="21"
                Cursor="Hand" />
    </Grid>
</UserControl>
